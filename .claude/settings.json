{
  // ─────────────────────────────────────────────────────────────────
  // Nomi — Claude Code project configuration
  //
  // This file is checked into git and applies to everyone working on
  // the project.  Personal overrides go in settings.local.json (gitignored).
  //
  // Docs: https://docs.anthropic.com/en/docs/claude-code/settings
  // ─────────────────────────────────────────────────────────────────

  // ── Permissions ──────────────────────────────────────────────────
  //
  // Security model: allow everything, deny dangerous patterns.
  // Bash(*) gives full filesystem + tool access in this project.
  // The deny list overrides allow — destructive git operations and
  // dangerous rm patterns are blocked regardless.
  //
  // If you need to add a temporary restriction, put it in
  // settings.local.json (gitignored) rather than editing this file.
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],

    "deny": [
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /bin*)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -rf /etc*)",
      "Bash(:(){ :|:& };:)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * -O - | sh)"
    ]
  },

  // ── Hooks ───────────────────────────────────────────────────────
  // Shell commands that fire on Claude Code events.  Use for
  // pre/post-commit checks, notifications, or custom workflows.
  //
  // Available events:
  //   PreToolUse      — fires before a tool executes (can block)
  //   PostToolUse     — fires after a tool completes
  //   Notification    — fires for user notifications
  //   UserPromptSubmit — fires when user submits a prompt
  //
  // Hooks receive context via JSON on stdin.  See:
  //   https://docs.anthropic.com/en/docs/claude-code/hooks
  //
  // Examples below are commented out — uncomment and tune as needed.

  // "hooks": {
