{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nomi",
  "scopeName": "source.nomi",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#decorators" },
    { "include": "#function-definitions" },
    { "include": "#class-definitions" },
    { "include": "#arrow-functions" },
    { "include": "#block-calls" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function-calls" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nomi",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.multi.nomi",
          "begin": "([furbFURB]*)(\"\"\"|''')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.prefix.nomi" },
            "2": { "name": "punctuation.definition.string.begin.nomi" }
          },
          "end": "\\2",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.nomi" }
          }
        },
        {
          "name": "string.quoted.double.nomi",
          "begin": "([furbFURB]*)(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.prefix.nomi" },
            "2": { "name": "punctuation.definition.string.begin.nomi" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.nomi" }
          },
          "patterns": [
            { "name": "constant.character.escape.nomi", "match": "\\\\." },
            { "name": "constant.other.placeholder.nomi", "match": "\\{[^}\\n]*\\}" }
          ]
        },
        {
          "name": "string.quoted.single.nomi",
          "begin": "([furbFURB]*)(')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.prefix.nomi" },
            "2": { "name": "punctuation.definition.string.begin.nomi" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.nomi" }
          },
          "patterns": [
            { "name": "constant.character.escape.nomi", "match": "\\\\." }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.nomi",
          "match": "^\\s*(@)([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
          "captures": {
            "1": { "name": "punctuation.definition.decorator.nomi" },
            "2": { "name": "entity.name.function.decorator.nomi" }
          }
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "name": "meta.function.nomi",
          "match": "^\\s*(async\\s+)?(func)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.modifier.async.nomi" },
            "2": { "name": "storage.type.function.nomi" },
            "3": { "name": "entity.name.function.nomi" }
          }
        }
      ]
    },
    "class-definitions": {
      "patterns": [
        {
          "name": "meta.class.nomi",
          "match": "^\\s*(class)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.class.nomi" },
            "2": { "name": "entity.name.type.class.nomi" }
          }
        }
      ]
    },
    "arrow-functions": {
      "patterns": [
        {
          "name": "storage.type.function.arrow.nomi",
          "match": "=>"
        }
      ]
    },
    "block-calls": {
      "patterns": [
        {
          "name": "meta.block-call.nomi",
          "match": "^\\s*([A-Za-z_]\\w*)\\s*(\\([^\\n]*\\))?\\s*(->\\s*[A-Za-z_]\\w*)?\\s*(:)",
          "captures": {
            "1": { "name": "support.function.block-call.nomi" },
            "3": { "name": "storage.modifier.block-parameter.nomi" },
            "4": { "name": "punctuation.section.block.begin.nomi" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nomi",
          "match": "\\b(?:if|elif|else|for|while|try|except|finally|with|as|match|case|return|yield|from|raise|break|continue|pass|in|is|not|and|or|async|await|global|nonlocal|assert|del|import)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.nomi",
          "match": "\\b(?:True|False|None|Ellipsis)\\b|\\.\\.\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nomi",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|(?:\\d[\\d_]*)(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d[\\d_]*)?j?)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nomi",
          "match": "=>|:=|->|==|!=|<=|>=|<>|\\+=|-=|\\*=|/=|//=|%=|\\*\\*=|<<=|>>=|[+\\-*/%@&|^~<>]=?|\\b(?:in|is|not|and|or)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.nomi",
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.nomi" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.nomi",
          "match": "\\b[A-Za-z_]\\w*\\b"
        }
      ]
    }
  }
}
