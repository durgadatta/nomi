# Nomi by Example — Block Calls & Yield
#
# A block call attaches caller-side code to a function.
# The callee invokes it with `yield` — no new control syntax.
# The block is written at the call site, inverting control.

# -- Basic: callee yields, block body executes once per yield ----------
func times(n):
    for i in range(n):
        yield

count = 0
times(3):
    count = count + 1
    print("tick " + str(count))

print("final count = " + str(count))

# -- Yielding values to the block --------------------------------------
func each(items):
    for item in items:
        yield item

each([10, 20, 30]) -> val:
    print("  item: " + str(val))

# -- Multiple yielded values — block params use standard assignment ---
each({"x": 1, "y": 2}.items()) -> key, val:
    print("  " + key + " = " + str(val))

# -- Filtering in the block — block body acts as a filter -------------
total = 0
each([3, -1, 7, -4, 2]) -> n:
    if n > 0:
        total = total + n

print("sum of positives = " + str(total))

# -- Error handling in the callee — retry with recovery ---------------
func retry(max_attempts):
    for i in range(max_attempts):
        try:
            yield
            print("  succeeded on attempt " + str(i + 1))
            return
        except Exception as e:
            print("  attempt " + str(i + 1) + " failed: " + str(e))
    print("  all " + str(max_attempts) + " attempts failed")

retry(3):
    print("  trying operation…")
    # The block can fail; callee catches and retries

# -- Ensuring cleanup after a block -----------------------------------
func with_cleanup():
    try:
        yield
    finally:
        print("  (cleanup done)")

with_cleanup():
    print("  doing work inside block")
