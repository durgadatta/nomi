# Nomi by Example — Binding Constraints, Data & Pattern Matching
#
# Constraints are checked at binding time — assignment, parameter
# passing, and rebinding. Data declarations generate structs with
# __init__, __repr__, and __eq__. Pattern matching binds and
# destructures in if, guard, and while forms.

# -- Type + predicate constraint --------------------------------------
is_positive = (x) => x > 0
score: int, is_positive = 72

print("score = " + str(score))

# -- Compound constraints — all checked on every bind ------------------
age: int, age >= 0, age <= 150 = 35
print("age = " + str(age))

# -- Constraint with user-facing message ------------------------------
#   name: constraint1, constraint2 else "message"
v: int, v > 0 else "must be positive" = 42
print("v = " + str(v))

# -- Function parameter with inline constraint ------------------------
func double_limited(x: (int, x > 0, x < 100)):
    return x * 2

print("double_limited(5) = " + str(double_limited(5)))

# -- Constraint on function parameter with message --------------------
func signup(age: (int, age >= 13 else "Signup requires age 13+")):
    return age

print("signup(25) = " + str(signup(25)))

# -- Type aliases — semantic names for domain types -------------------
type UserId = int
type JsonStr = str

uid: UserId = 101
payload: JsonStr = "{\"ok\": true}"
print("uid = " + str(uid) + ", payload = " + payload)

# -- Data declaration — a struct with auto-generated methods ----------
data Point:
    x: float
    y: float

p = Point(3.0, 5.0)
origin = Point(0.0, 0.0)
print("Point(3,5) = " + str(p))
print("origin     = " + str(origin))
print("p == origin = " + str(p == origin))

# -- Data with constrained fields -------------------------------------
data PositivePoint:
    x: float where x > 0
    y: float where y > 0

pp = PositivePoint(2.5, 10.0)
print("PositivePoint(2.5, 10) = " + str(pp))

# -- Match block expression — indent, expr on same line as case -------
result = match score:
    case 100: "perfect"
    case s if s >= 90: "excellent"
    case _: "regular"

print("grade = " + result)

# -- Match inline expression — single-line, => arrows and ; -----------
label = match score: case 100 => "perfect"; case _ => "ok"
print("label = " + label)

# -- Match statement with suite bodies --------------------------------
match score:
    case 100:
        print("top marks!")
    case _:
        print("keep going")

# -- Match with guards — full destructuring in each arm ---------------
value = 42
match value:
    case n if n < 0:
        signal = "negative"
    case 0:
        signal = "zero"
    case n if n > 100:
        signal = "large"
    case _:
        signal = "normal"

print("signal = " + signal)

# -- if-let — conditionally destructure and bind a pattern ------------
config = {"theme": "dark", "scale": 1.5}
if {"theme": t, "scale": s} = config:
    print("theme is " + t + ", scale = " + str(s))

# -- guard-let — require a pattern; exit early if it fails ------------
func first(sequence):
    guard [head, *tail] = sequence:
        return None
    return head

print("first([10,20,30]) = " + str(first([10, 20, 30])))
print("first([])        = " + str(first([])))

# -- while-let — loop while a destructuring pattern holds -------------
items = [1, 2, 3]
total = 0
while [h, *rest] = items:
    total = total + h
    items = rest

print("while-let total = " + str(total))
