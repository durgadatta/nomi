# ══════════════════════════════════════════════════════════════════════
#   Nomi by Example — A Guided Tour
#
#   Each section introduces one language feature with simple examples.
#   Run with:  nomi samples/demo.nomi
# ══════════════════════════════════════════════════════════════════════

# ── 1. Functions ───────────────────────────────────────────────────
# Traditional function definition
func greet(name):
    return "Hello, " + name

# Arrow function — single-param (no parens) or multi-param
square = x => x * x
add = (a, b) => a + b

# Lightweight equation — f(a, b) = expr
pi() = 3.14

# Underscore hole-filling lambdas (Scala-style)
double = _ * 2
upcase = _.upper()

# Piecewise definitions (Haskell-style)
# Contiguous equations with the same name merge into one function.
fact(1) = 1
fact(n) = fact(n - 1) * n

# Where clause — local bindings
area = pi * r * r where:
    pi = 3.14159
    r = 5

twice = x * 2 where x = 5    # inline form


# ── 2. Control Flow ─────────────────────────────────────────────────
# unless — Ruby-style inverted if
x = 5
unless x > 10:
    label = "not big"         # executes when condition is False


# ── 3. Null Handling ────────────────────────────────────────────────
# Null coalescing: use a default when value is None
name = None ?? "anonymous"

# Optional chaining: safe navigation
d1 = {"key": "found"}
d2 = None
v1 = d1?.get("key")     # "found"
v2 = d2?.get("key")     # None


# ── 4. Collections & Data ───────────────────────────────────────────
# Ranges: 1..5 (inclusive), 1..<5 (exclusive)
one_to_five = list(1..5)
one_to_four = list(1..<5)

# Pipeline: thread a value through functions
total = 1..10 |> list |> sum    # 55


# ── Results ─────────────────────────────────────────────────────────
print("1. greet(Alice) = " + greet("Alice"))
print("1. square(5) = " + str(square(5)))
print("1. add(3,4) = " + str(add(3, 4)))
print("1. pi() = " + str(pi()))
print("1. double(21) = " + str(double(21)))
print("1. upcase(hi) = " + upcase("hi"))
print("1. fact(5) = " + str(fact(5)))
print("1. area = " + str(area))

print("2. label = " + label)

print("3. None ?? anonymous = " + name)
print("3. d1?.get(key) = " + v1)
print("3. d2?.get(key) = " + str(v2))

print("4. 1..5 = " + str(one_to_five))
print("4. 1..<5 = " + str(one_to_four))
print("4. 1..10 |> sum = " + str(total))
