# ══════════════════════════════════════════════════════════════════════
#   Nomi by Example — A Guided Tour
#
#   Each section introduces one language feature with simple examples.
#   Run with:  nomi samples/demo.nomi
# ══════════════════════════════════════════════════════════════════════

# ── 1. Functions ───────────────────────────────────────────────────
# Traditional function definition
func greet(name):
    return "Hello, " + name

# Arrow function (lambda)
square = (x) => x * x

# Lightweight equation — f(a, b) = expr
add(a, b) = a + b
pi() = 3.14

# Underscore hole-filling lambdas (Scala-style)
double = _ * 2            # creates (x) => x * 2
upcase = _.upper()         # creates (x) => x.upper()

# Piecewise definitions (Haskell-style)
# Contiguous equations with the same name merge into one function.
fact(1) = 1
fact(n) = fact(n - 1) * n

# Where clause — local bindings
area = pi * r * r where:    # block form (with colon + indent)
    pi = 3.14159
    r = 5

twice = x * 2 where x = 5    # inline form (single binding)


# ── 2. Null Handling ────────────────────────────────────────────────
# Null coalescing: use a default when value is None
name = None ?? "anonymous"      # → "anonymous"
count = 5 ?? 10                 # → 5  (left is not None)


# ── 3. Collections & Data ───────────────────────────────────────────
# Ranges: 1..5 (inclusive), 1..<5 (exclusive)
one_to_five = list(1..5)         # [1, 2, 3, 4, 5]
one_to_four = list(1..<5)        # [1, 2, 3, 4]

# Pipeline: thread a value through functions
total = 1..10 |> list |> sum     # 55  — sum of 1 through 10

# Underscore hole used in expression context
doubled = double(21)             # 42


# ── Results ─────────────────────────────────────────────────────────
print("1. greet(Alice) = " + greet("Alice"))
print("1. square(5) = " + str(square(5)))
print("1. add(3,4) = " + str(add(3, 4)))
print("1. pi() = " + str(pi()))
print("1. double(21) = " + str(double(21)))
print("1. upcase(hi) = " + str(upcase("hi")))
print("1. fact(5) = " + str(fact(5)))
print("1. area = " + str(area))

print("2. None ?? anonymous = " + str(name))
print("2. 5 ?? 10 = " + str(count))

print("3. 1..5 = " + str(one_to_five))
print("3. 1..<5 = " + str(one_to_four))
print("3. 1..10 |> sum = " + str(total))
