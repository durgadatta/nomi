# ════════════════════════════════════════════════════════════════
#   Nomi — A Guided Tour
#
#   Each section introduces Nomi's syntax through examples that
#   aim to feel natural, not contrived.  Run with:
#       nomi samples/demo.nomi
# ════════════════════════════════════════════════════════════════


# ── Functions ───────────────────────────────────────────────────
# Lightweight equation —  f(a, b) = expr
# No `return` needed; the expression is the body.
add(a, b) = a + b

# Arrow expression — (params) => body, fits inline callbacks.
double = x => x * 2
distance = (x1, y1, x2, y2) => ((x2 - x1) ** 2 + (y2 - y1) ** 2) ** 0.5

# Piecewise definition — adjacent equations with the same name
# merge into a single function.  The canonical way to write
# recursive functions with base cases.
fib(0) = 0
fib(1) = 1
fib(n) = fib(n - 1) + fib(n - 2)

# Guarded equations — a `when` condition restricts a clause.
# Reads like a mathematical case split.
sign(n) when n > 0 =  1
sign(n) when n < 0 = -1
sign(n)            =  0

# Single-arg without parens — clean for unary functions.
sq x = x * x

# Default arguments on equations.
greet(name, greeting="Hi") = greeting + ", " + name

# Where clause — the main expression comes first, supporting
# definitions follow.  Feels natural in formula-heavy code.
volume = pi * r * r * h where:
    pi = 3.14159
    r  = 2.5
    h  = 10.0

# Underscore lambdas — each _ becomes a positional parameter.
# Best in filter / map chains where naming adds nothing.
is_even = _ % 2 == 0
concat3 = _ + _ + _
increment = _ + 1

# Named-hole lambdas — $name creates a parameter called `name`.
# Feels like string interpolation that produces a function.
sort_key = $1["name"]           # one-arg: (x) => x["name"]
greeting = "Hello, " + $name    # (name) => "Hello, " + name

# Operator sections — (+1) is an "add one" function, (2*) is
# "multiply by 2".  Haskell-style shorthand for simple mappings.
next = (+1)


# ── Ranges, Pipeline & Composition ──────────────────────────────
# Ranges: 1..10 inclusive, 1..<10 exclusive, by N stepped.
ten = list(1..10)
nine = list(1..<10)
odds = list(1..20 by 2)

# Pipeline — thread a value through functions left-to-right.
# Each `|>` feeds the result into the next function.
squares_sum = 1..5 |> list |> sum

# Function composition — build a new function from two.
# f >>> g  means  apply f, then g:  (f >>> g)(x) == g(f(x))
neg_abs = abs >>> (x => -x)


# ── Null Handling ───────────────────────────────────────────────
# ?? returns the right-hand side when the left is None.
user = None
display = user ?? "guest"

# ?. short-circuits to None when the receiver is None.
# Avoids nested `if x is not None` checks.
data = {"name": "Ada"}
first_char = data?.get("name")?.[0]  # "A"
missing    = data?.get("age")        # None


# ── Pattern Matching ────────────────────────────────────────────
# Piecewise with guards — a natural case split.  Each clause
# is an independent equation that merges into one function.
grade(score) when score >= 90 = "A"
grade(score) when score >= 80 = "B"
grade(score) when score >= 70 = "C"
grade(score) when score >= 60 = "D"
grade(_) = "F"

# Match as expression (inline) — single-line, => arrows.
# Good for quick value dispatch where a function feels heavy.
label = match 3: case 1 => "one"; case 2 => "two"; case _ => "many"

# Match as statement with suite bodies — full blocks per case.
signal = ""
match 15:
    case n if n < 0:
        signal = "negative"
    case 0:
        signal = "zero"
    case _:
        signal = "positive"


# ── Control Flow ────────────────────────────────────────────────
# unless — reads better than `if not` for guard clauses.
token = "valid"
status = "ok"
unless token == "valid":
    status = "rejected"

# if-let — conditionally destructure and bind a pattern.
config = {"theme": "dark"}
if {"theme": t} = config:
    theme = t                   # "dark"

# guard-let — require a pattern; exit early if it fails.
func first(sequence):
    guard [head, *tail] = sequence:
        return None
    return head

first_val = first([10, 20, 30])
empty_val = first([])

# while-let — loop while a destructuring pattern holds.
items = [1, 2, 3]
total = 0
while [h, *rest] = items:
    total = total + h
    items = rest

# try as expression — produce a value, fall back on error.
parsed = try int("not-a-number") except ValueError: 0

# defer — schedule cleanup right next to acquisition.
# Blocks execute LIFO at function exit (Go / Zig style).
func tracked_calc(x):
    defer print("  done: x was " + str(x))
    defer print("  starting…")
    return x * x

result = tracked_calc(7)


# ── Collections ─────────────────────────────────────────────────
# Spread — unpack an iterable inline.
middle = [2, 3]
all_nums = [1, *middle, 4, 5]

# Filter / map with underscore lambdas — concise.
nums = [3, -2, 8, -5, 1]
positive_nums = filter(x => x > 0, nums)
doubled_nums = map(x => x * 2, nums)

# Operator section as a mapping function.
incremented = map((+1), nums)


# ── Types & Data ────────────────────────────────────────────────
# Type alias — give semantic names to domain types.
type UserId = int
type JsonStr = str

# Data declaration — a struct with a generated constructor.
data Point:
    x: float
    y: float

p = Point(3.0, 5.0)
origin = Point(0.0, 0.0)

# Constraint annotation — checked at binding time.
age: int, age >= 0, age <= 150 = 35
positive: int, positive > 0 = 95

# Parameter constraint — enforced on every call.
func sqrt(x: (x >= 0)):
    return x ** 0.5

# Constraint with a user-facing message.
#   x: constraint else "message"
v: int, v > 0 else "must be positive" = 42


# ── Block Calls ─────────────────────────────────────────────────
# A callee yields control to a caller-attached block.
# The block is written at the call site — inversion of control.

func twice():
    yield
    yield

count = 0
twice():
    count = count + 1

# Block with a parameter — the callee yields values to the block.
func each(sequence):
    for item in sequence:
        yield item

collected = []
each([1, 2, 3]) -> n:
    collected = collected + [n * 2]


# ── Results ─────────────────────────────────────────────────────
print("add(3, 4)         = " + str(add(3, 4)))
print("double(7)         = " + str(double(7)))
print("distance(3,4,0,0)  = " + str(distance(3, 4, 0, 0)))
print("fib(10)           = " + str(fib(10)))
print("sign(-12)         = " + str(sign(-12)))
print("sign(0)           = " + str(sign(0)))
print("sq(5)             = " + str(sq(5)))
print("greet(Bob, Hey)   = " + greet("Bob", "Hey"))
print("volume            = " + str(volume))
print("is_even(7)        = " + str(is_even(7)))
print("concat3(a,b,c)    = " + concat3("a", "b", "c"))
print("increment(5)      = " + str(increment(5)))
print("sort_key(name:K)  = " + sort_key({"name": "Kim"}))
print("greeting(world)   = " + greeting("world"))
print("next(5)           = " + str(next(5)))
print()
print("1..10             = " + str(ten))
print("1..<10            = " + str(nine))
print("1..20 by 2        = " + str(odds))
print("squares_sum 1..5  = " + str(squares_sum))
print("neg_abs(-5)       = " + str(neg_abs(-5)))
print()
print("user ?? 'guest'    = " + display)
print("data?.name?.[0]   = " + str(first_char))
print("data?.age         = " + str(missing))
print()
print("grade(85)         = " + grade(85))
print("grade(72)         = " + grade(72))
print("inline match 3    = " + label)
print("match stmt signal  = " + signal)
print()
print("unless status     = " + status)
print("if-let theme      = " + theme)
print("guard-let first   = " + str(first_val))
print("guard-let empty   = " + str(empty_val))
print("while-let total   = " + str(total))
print("try int('nan')    = " + str(parsed))
print()
print("spread            = " + str(all_nums))
print("positive(nums)    = " + str(list(positive_nums)))
print("doubled(nums)     = " + str(list(doubled_nums)))
print("incremented(nums) = " + str(list(incremented)))
print()
print("Point(3,5)        = " + str(p))
print("origin            = " + str(origin))
print("age constraint    = " + str(age))
print("positive val      = " + str(positive))
print("sqrt(144)         = " + str(sqrt(144)))
print("positive_val      = " + str(v))
print()
print("block: count      = " + str(count))
print("block: collected  = " + str(collected))
print("defer example:")
print("  " + str(result))
