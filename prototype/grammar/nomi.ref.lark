// Nomi grammar - assembled from layers in prototype/grammar/layers/
// Not read at runtime. Regenerate: python3 -m tools.syntax.grammar_ref

// Layer: terminals — must be assembled first (%declare, %ignore, terminal defs)
//
// All token-level definitions: whitespace, comments, newlines,
// identifiers, numbers, strings, and the %declare/%ignore directives
// required by Lark's PythonIndenter postlexer.
//
// IMPORTANT: terminals referenced by %ignore (COMMENT) must be defined
// BEFORE the %ignore directive.

_NEWLINE: ( /\r?\n[\t ]*/ | COMMENT )+

COMMENT: /#[^\n]*/

%ignore /[\t \f]+/
%ignore /\\[\t \f]*\r?\n/
%ignore COMMENT
%declare _INDENT _DEDENT
%declare SECTION_OP _BLOCK_COLON _CASE_COLON _CASE_IF _POSTFIX_IF _POSTFIX_UNLESS _ARROW_LPAR _ARROW_RPAR

!name: NAME | "match" | "case" | "type" | "by" | "guard" | "data"
NAME: /[^\W\d]\w*/

// Positional hole references (Swift-style) — before number definitions
DOLLAR_HOLE: /\$[0-9]+/
DOLLAR_NAME: /\$[^\W\d]\w*/

// Range + safe navigation operators — before number definitions
RANGE_INCL: /\.\./
RANGE_EXCL: /\.\.</
SAFE_DOT: "?."
_FAT_ARROW: "=>"

// Explicit operator tokens keep LALR parse trees lossless without wrapper
// rules that collide with unary, binary, spread, and bare-star contexts.
PLUS: "+"
MINUS: "-"
TILDE: "~"
VBAR: "|"
CIRCUMFLEX: "^"
AMPER: "&"
LSHIFT: "<<"
RSHIFT: ">>"
STAR: "*"
AT: "@"
SLASH: "/"
PERCENT: "%"
DOUBLESLASH: "//"
DOUBLESTAR: "**"

// Function composition
COMP_FWD: ">>>"
COMP_BWD: "<<<"

STRING: /([ubf]?r?|r[ubf])("(?!"").*?(?<!\\)(\\\\)*?"|'(?!'').*?(?<!\\)(\\\\)*?')/i
LONG_STRING: /([ubf]?r?|r[ubf])(""".*?(?<!\\)(\\\\)*?"""|'''.*?(?<!\\)(\\\\)*?''')/is
number: DEC_NUMBER | HEX_NUMBER | BIN_NUMBER | OCT_NUMBER | FLOAT_NUMBER | IMAG_NUMBER
string: STRING | LONG_STRING

_SPECIAL_DEC: "0".."9"        ("_"?  "0".."9"                       )*
DEC_NUMBER:   "1".."9"        ("_"?  "0".."9"                       )*
          |   "0"             ("_"?  "0"                            )* /(?![1-9])/
HEX_NUMBER.2: "0" ("x" | "X") ("_"? ("0".."9" | "a".."f" | "A".."F"))+
OCT_NUMBER.2: "0" ("o" | "O") ("_"?  "0".."7"                       )+
BIN_NUMBER.2: "0" ("b" | "B") ("_"?  "0".."1"                       )+
_EXP: ("e"|"E") ["+" | "-"] _SPECIAL_DEC
DECIMAL: "." _SPECIAL_DEC | _SPECIAL_DEC "." _SPECIAL_DEC
FLOAT_NUMBER.2: _SPECIAL_DEC _EXP | DECIMAL _EXP?
IMAG_NUMBER.2: (_SPECIAL_DEC | FLOAT_NUMBER) ("J" | "j")


// Layer: expressions — logical, comparison, arithmetic, atoms
//
// Binary operators produce flat left-to-right BinOp chains.
// Precedence is restructured by the Precedence desugar pass.
// LALR note: operator tokens are referenced directly instead of reduced
// through _unary_op/_binary_op wrapper rules.  The wrapper split created
// reduce/reduce conflicts where +, -, and * are legal in several contexts.

single_input: _NEWLINE | simple_stmt | compound_stmt _NEWLINE
file_input: (_NEWLINE | stmt)*
eval_input: testlist _NEWLINE*

suite: simple_stmt | _NEWLINE _INDENT stmt+ _DEDENT

// -- logical ---------------------------------------------------------
?test: func_expr | match_block_expr | match_inline | pipe_expr ("if" or_test "else" test)? | assign_expr | try_expr
?pipe_expr: compose_expr (PIPE_FWD compose_expr)*
?compose_expr: or_test ((COMP_BWD | COMP_FWD) or_test)*
PIPE_FWD: "|>"
?test_nocond: or_test
?or_test: nullish_expr ("or" nullish_expr)*
?nullish_expr: and_test (NULLISH and_test)*
?and_test: not_test_ ("and" not_test_)*
NULLISH: "??"
?not_test_: "not" not_test_ -> not_test | comparison

// -- comparisons (chains: a < b < c) ---------------------------------
?comparison: range_expr (comp_op range_expr)*
!comp_op: "<"|">"|"=="|">="|"<="|"<>"|"!="|"in"|"not" "in"|"is"|"is" "not"

// -- range: start..end (inclusive), start..<end (exclusive) ------------
?range_expr: bin_expr
           | bin_expr RANGE_INCL bin_expr ["by" bin_expr] -> range_inclusive
           | bin_expr RANGE_EXCL bin_expr ["by" bin_expr] -> range_exclusive

// -- flat binary ops (restructured by Precedence pass) ----------------
?expr: bin_expr
?bin_expr: factor ((VBAR | CIRCUMFLEX | AMPER | LSHIFT | RSHIFT | PLUS | MINUS | STAR | AT | SLASH | PERCENT | DOUBLESLASH) factor)*

// -- unary, power, await ----------------------------------------------
?factor.3: (PLUS | MINUS | TILDE) factor | power
?power: await_expr (DOUBLESTAR factor)?
?await_expr: AWAIT? atom_expr
AWAIT: "await"

// -- atoms ------------------------------------------------------------
// TODO(NOMI-SUBSTRATE-013): Future fenced forms such as quote: and use units:
// should enter as syntax-island nodes with raw text and spans before the
// ordinary expression grammar tries to understand their domain notation.
?atom: "(" paren_expr ")" -> paren_expr
     | "[" brack_expr "]" -> brack_expr
     | "{" brace_expr "}" -> brace_expr
     | name -> var
     | number
     | string_concat
     | DOLLAR_HOLE -> dollar_hole
     | DOLLAR_NAME -> dollar_hole
     | "..." -> ellipsis
     | "None"    -> const_none
     | "True"    -> const_true
     | "False"   -> const_false

// -- parenthesized / bracketed / braced content (split from atom to
//    reduce Earley items — these are predicted only when the delimiter
//    is scanned, not at every position where atom is predicted.)
paren_expr: yield_expr
          | section -> section
          | _tuple_inner? -> tuple
          | comprehension{test_or_star_expr} -> tuple_comprehension
          | test

brack_expr: _exprlist? -> list
          | comprehension{test_or_star_expr} -> list_comprehension

brace_expr: _dict_exprlist? -> dict
          | comprehension{key_value} -> dict_comprehension
          | _exprlist -> set
          | comprehension{test} -> set_comprehension

?string_concat: string+

// -- func_expr --------------------------------------------------------
func_expr: _ARROW_LPAR [parameters] _ARROW_RPAR _FAT_ARROW test ["->" test]
         | NAME _FAT_ARROW test ["->" test]
assign_expr: name ":=" test

// -- tuple / list expression helpers ----------------------------------
star_expr: "*" expr
_tuple_inner: test_or_star_expr (("," test_or_star_expr)+ [","] | ",")
?test_or_star_expr: test | star_expr
?testlist: test | testlist_tuple
testlist_tuple: test (("," test)+ [","] | ",")
?exprlist: (expr|star_expr) | (expr|star_expr) (("," (expr|star_expr))+ [","]|",")
_exprlist: test_or_star_expr (","  test_or_star_expr)* [","]
_dict_exprlist: (key_value | "**" expr) ("," (key_value | "**" expr))* [","]
key_value: test ":"  test

// -- operator sections: (+2), (2*), (+)  (Haskell-style) --------------
?section: SECTION_OP test  -> left_section
        | test SECTION_OP  -> right_section
        | SECTION_OP       -> operator_value

// -- subscript --------------------------------------------------------
?subscriptlist: subscript | subscript (("," subscript)+ [","] | ",") -> subscript_tuple
?subscript: test | ([test] ":" [test] [sliceop]) -> slice
sliceop: ":" [test]

// -- try expression (Nomi) --------------------------------------------
// Single-line form: try body except Error as e: handler
try_expr: "try" test try_except_clause+
?try_except_clause: "except" NAME ["as" NAME] ":" test

// -- inline match expression (Nomi) -----------------------------------
// Single-line form: match value: case 1 => "one"; case _ => "many"
match_inline: "match" test ":" case_expr (";" case_expr)* [";"]
case_expr: "case" pattern [_case_if test] _FAT_ARROW test

// Indented expression form: match value:\n    case 1: "one"
match_block_expr: "match" test _suite_colon _NEWLINE _INDENT case_block_expr+ _DEDENT
case_block_expr: "case" pattern [_case_if test] _case_colon match_block_expr
               | "case" pattern [_case_if test] _case_colon test _NEWLINE


// Layer: statements — stmt, compound_stmt, funcdef, classdef,
// block_call_stmt, imports, control flow.

_suite_colon: ":" | _BLOCK_COLON

?stmt: simple_stmt | compound_stmt | block_call_stmt
?simple_stmt: match_block_simple_stmt
            | small_stmt (";" small_stmt)* [";"] _NEWLINE
            | flow_stmt _POSTFIX_IF test _NEWLINE -> postfix_if
            | flow_stmt _POSTFIX_UNLESS test _NEWLINE -> postfix_unless
            | small_stmt "where" _suite_colon suite  -> assign_where
            | small_stmt "where" small_stmt _NEWLINE  -> assign_where_inline
?small_stmt: (type_alias | func_equation | defer_stmt | expr_stmt | assign_stmt | del_stmt | pass_stmt
             | flow_stmt | import_stmt | global_stmt | nonlocal_stmt
             | assert_stmt)
?match_block_simple_stmt.2: testlist_star_expr "=" match_block_expr -> assign_match_block
                          | "return" match_block_expr -> return_match_block

// -- funcdef (Nomi: "func" replaces "def") ----------------------------
funcdef: "func" name "(" [parameters] ")" ["->" test] _suite_colon suite
async_funcdef: "async" funcdef

// -- lightweight function equation: f(a, b) = expr  (Nomi) ------------
// Simple form:  add(a, b) = a + b
// No-parens:    double x = x * 2  (single-arg only)
// Guarded:      sign(n) when n > 0 = 1
// Piecewise:    fact(1) = 1; fact(n) = fact(n-1) * n  (contiguous merge)
func_equation: call_equation_head "=" test ["->" test] -> func_equation_plain_call
             | call_equation_head "when" test "=" test ["->" test] -> func_equation_guarded_call
             | name NAME "=" test ["->" test] -> func_equation_no_parens_plain
             | name NAME "when" test "=" test ["->" test] -> func_equation_no_parens_guarded
call_equation_head.2: atom_expr "(" [arguments] ")" -> funccall
func_eq_args: func_eq_arg ("," func_eq_arg)*
?func_eq_arg: NAME ["=" test] -> name_arg
            | test -> value_arg

// -- type alias (Nomi) -------------------------------------------------
type_alias: "type" NAME "=" test

// -- defer (Nomi) ------------------------------------------------------
defer_stmt: "defer" (expr_stmt | assign_stmt)

// -- decorators -------------------------------------------------------
decorator: "@" dotted_name [ "(" [arguments] ")" ] _NEWLINE
decorators: decorator+
decorated: decorators (classdef | funcdef | async_funcdef)

// -- classdef ---------------------------------------------------------
classdef: "class" name ["(" [arguments] ")"] _suite_colon suite

// -- simple statements ------------------------------------------------
expr_stmt: testlist_star_expr
pass_stmt: "pass"
?flow_stmt: break_stmt | continue_stmt | return_stmt | raise_stmt | yield_stmt
break_stmt: "break"
continue_stmt: "continue"
return_stmt: "return" [testlist]
yield_stmt: yield_expr
raise_stmt: "raise" [test ["from" test]]
global_stmt: "global" name ("," name)*
nonlocal_stmt: "nonlocal" name ("," name)*
assert_stmt: "assert" test ["," test]
del_stmt: "del" exprlist

// -- imports ----------------------------------------------------------
import_stmt: import_name | import_from
import_name: "import" dotted_as_names
import_from: "from" (dots? dotted_name | dots) "import" ("*" | "(" import_as_names ")" | import_as_names)
!dots: "."+
import_as_name: name ["as" name]
dotted_as_name: dotted_name ["as" name]
import_as_names: import_as_name ("," import_as_name)* [","]
dotted_as_names: dotted_as_name ("," dotted_as_name)*
dotted_name: name ("." name)*

// -- compound statements ----------------------------------------------
// TODO(NOMI-SUBSTRATE-012): New language words should remain soft keywords
// unless a feature manifest proves they must be reserved globally. Add
// ambiguity tests whenever this list grows.
?compound_stmt: if_stmt | guard_stmt | unless_stmt | while_stmt | for_stmt | try_stmt | match_stmt
              | with_stmt | funcdef | classdef | decorated | async_stmt | data_decl
async_stmt: "async" (funcdef | with_stmt | for_stmt)
if_stmt: "if" test _suite_colon suite elifs ["else" _suite_colon suite]
       | "if" pattern "=" test _suite_colon suite ["else" _suite_colon suite] -> if_let_stmt
guard_stmt: "guard" pattern "=" test _suite_colon suite
elifs: elif_*
elif_: "elif" test _suite_colon suite
unless_stmt: "unless" test _suite_colon suite
while_stmt: "while" pattern "=" test _suite_colon suite -> while_let_stmt
          | "while" test _suite_colon suite ["else" _suite_colon suite]
for_stmt: "for" exprlist "in" testlist _suite_colon suite ["else" _suite_colon suite]
try_stmt: "try" _suite_colon suite except_clauses ["else" _suite_colon suite] [finally]
        | "try" _suite_colon suite finally   -> try_finally
finally: "finally" _suite_colon suite
except_clauses: except_clause+
except_clause: "except" [test ["as" name]] _suite_colon suite
with_stmt: "with" with_items _suite_colon suite
with_items: with_item ("," with_item)*
with_item: test ["as" name]

// -- block call (Nomi) ------------------------------------------------
// TODO(NOMI-SUBSTRATE-010): Keep this surface, but lower it through a
// Nomi-owned BlockCall node instead of encoding the block as a Python AST
// keyword payload.
block_call_stmt: block_call_head [ "->" testlist_star_expr ] _suite_colon block_suite
block_call_head.2: atom_expr "(" [arguments] ")" -> funccall
block_suite: _NEWLINE _INDENT stmt+ _DEDENT -> suite

// -- data declaration (Nomi) ------------------------------------------
data_decl: "data" NAME _suite_colon _NEWLINE _INDENT data_field+ _DEDENT
?data_field: data_field_constrained | data_field_typed | data_field_where | data_field_bare
data_field_typed: NAME ":" test _NEWLINE
data_field_constrained: NAME ":" test "where" test _NEWLINE
data_field_where: NAME "where" test _NEWLINE
data_field_bare: NAME _NEWLINE

// -- yield ------------------------------------------------------------
yield_expr: "yield" [testlist]
          | "yield" "from" test -> yield_from


// Layer: patterns — match/case pattern matching.

match_stmt: "match" test _suite_colon _NEWLINE _INDENT case+ _DEDENT
case: "case" pattern [_case_if test] _case_colon suite
_case_colon: _CASE_COLON | _suite_colon
_case_if: "if" | _CASE_IF

?pattern: sequence_item_pattern "," _sequence_pattern -> sequence_pattern
        | as_pattern
?as_pattern: or_pattern ("as" NAME)?
?or_pattern: closed_pattern ("|" closed_pattern)*
?closed_pattern.2: literal_pattern
                 | NAME -> capture_pattern
                 | NAME ":" test -> constrained_capture
                 | "_" -> any_pattern
                 | attr_pattern
                 | "(" as_pattern ")"
                 | "[" _sequence_pattern "]" -> sequence_pattern
                 | "(" (sequence_item_pattern "," _sequence_pattern)? ")" -> sequence_pattern
                 | "{" (mapping_item_pattern ("," mapping_item_pattern)* ","?)? "}" -> mapping_pattern
                 | "{" (mapping_item_pattern ("," mapping_item_pattern)* ",")? "**" NAME ","? "}" -> mapping_star_pattern
                 | class_pattern

literal_pattern: inner_literal_pattern
?inner_literal_pattern.2: "None" -> const_none
                        | "True" -> const_true
                        | "False" -> const_false
                        | STRING -> string
                        | number

attr_pattern: NAME ("." NAME)+ -> value
name_or_attr_pattern.2: NAME ("." NAME)* -> value
mapping_item_pattern: (literal_pattern|attr_pattern) ":" as_pattern
_sequence_pattern.2: (sequence_item_pattern ("," sequence_item_pattern)* ","?)?
?sequence_item_pattern.2: as_pattern | "*" NAME -> star_pattern

class_pattern: name_or_attr_pattern "(" [arguments_pattern ","?] ")"
arguments_pattern: pos_arg_pattern ["," keyws_arg_pattern]
                 | keyws_arg_pattern -> no_pos_arguments
pos_arg_pattern: as_pattern ("," as_pattern)*
keyws_arg_pattern: keyw_arg_pattern ("," keyw_arg_pattern)*
keyw_arg_pattern: NAME "=" as_pattern


// Layer: bindings — assignment, augmented assignment, parameters.

assign_stmt: annassign | augassign | assign

// Nomi: annotation accepts a constraint list. Individual constraints may carry
// user-facing messages with: constraint else "message".
annassign: testlist_star_expr ":" constraint_list  ["=" test]
assign: testlist_star_expr ("=" (yield_expr|testlist_star_expr))+
augassign: testlist_star_expr augassign_op (yield_expr|testlist)
!augassign_op: "+=" | "-=" | "*=" | "@=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>=" | "**=" | "//="

?constraint_list: constraint_item
                | constraint_item ("," constraint_item)+ ","? -> constraint_tuple
?constraint_item.2: test
                  | test "else" string_concat -> constraint_message

?testlist_star_expr: test_or_star_expr
                   | test_or_star_expr ("," test_or_star_expr)+ ","?  -> tuple
                   | test_or_star_expr ","  -> tuple

// -- function / call parameters --------------------------------------
parameters: paramvalue ("," paramvalue)* ["," SLASH ("," paramvalue)*] ["," [starparams | kwparams]]
          | starparams
          | kwparams
starparams: (starparam | starguard) poststarparams
starparam: "*" typedparam
starguard: "*"
poststarparams: ("," paramvalue)* ["," kwparams]
kwparams: "**" typedparam ","?
?paramvalue: typedparam ("=" test)?
?typedparam.2: name (":" param_constraint)?
?param_constraint: constraint_item
                 | "(" constraint_list ")" -> grouped_constraint

// -- call arguments ---------------------------------------------------
arguments: argvalue ("," argvalue)*  ("," [ starargs | kwargs])?
         | starargs
         | kwargs
         | comprehension{test}
starargs: stararg ("," stararg)* ("," argvalue)* ["," kwargs]
stararg: "*" test
kwargs: "**" test ("," argvalue)*
?argvalue: test ("=" test)?


// Layer: calls — function call, attribute/subscript access, comprehensions.

?atom_expr: atom_expr SAFE_DOT name "(" [arguments] ")" -> safe_call
          | atom_expr SAFE_DOT name          -> safe_getattr
          | atom_expr SAFE_DOT "[" subscriptlist "]" -> safe_getitem
          | atom_expr "(" [arguments] ")"      -> funccall
          | atom_expr "[" subscriptlist "]"  -> getitem
          | atom_expr "." name               -> getattr
          | atom

// -- comprehensions ---------------------------------------------------
comprehension{comp_result}: comp_result comp_fors [comp_if]
comp_fors: comp_for+
comp_for: [ASYNC] "for" exprlist "in" or_test
ASYNC: "async"
?comp_if: "if" test_nocond

encoding_decl: name

// utility
cs_list{item}: item ("," item)* ","?
_cs_list{item}: item ("," item)* ","?

