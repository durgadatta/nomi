// Layer: bindings — assignment, augmented assignment, parameters.

assign_stmt: annassign | augassign | assign

// Nomi: annotation accepts a constraint list. Individual constraints may carry
// user-facing messages with: constraint else "message".
annassign: testlist_star_expr ":" constraint_list  ["=" test]
assign: testlist_star_expr ("=" (yield_expr|testlist_star_expr))+
augassign: testlist_star_expr augassign_op (yield_expr|testlist)
!augassign_op: "+=" | "-=" | "*=" | "@=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>=" | "**=" | "//="

?constraint_list: constraint_item
                | constraint_item ("," constraint_item)+ ","? -> constraint_tuple
?constraint_item.2: test
                  | test "else" string_concat -> constraint_message

?testlist_star_expr: test_or_star_expr
                   | test_or_star_expr ("," test_or_star_expr)+ ","?  -> tuple
                   | test_or_star_expr ","  -> tuple

// -- function / call parameters --------------------------------------
parameters: paramvalue ("," paramvalue)* ["," SLASH ("," paramvalue)*] ["," [starparams | kwparams]]
          | starparams
          | kwparams
starparams: (starparam | starguard) poststarparams
starparam: "*" typedparam
starguard: "*"
poststarparams: ("," paramvalue)* ["," kwparams]
kwparams: "**" typedparam ","?
?paramvalue: typedparam ("=" test)?
?typedparam.2: name (":" param_constraint)?
?param_constraint: constraint_item
                 | "(" constraint_list ")" -> grouped_constraint

// -- call arguments ---------------------------------------------------
arguments: argvalue ("," argvalue)*  ("," [ starargs | kwargs])?
         | starargs
         | kwargs
         | comprehension{test}
starargs: stararg ("," stararg)* ("," argvalue)* ["," kwargs]
stararg: "*" test
kwargs: "**" test ("," argvalue)*
?argvalue: test ("=" test)?
