// ── Nomi PEG Grammar ──────────────────────────────────────────────────
// pest-readable-cst: a readable PEG grammar for the Nomi language.
//
// Whitespace handling:
//   WHITESPACE (auto-skipped) = spaces, tabs, comments
//   Newlines are explicit tokens — they terminate statements.
//   INDENT / DEDENT are injected by the Rust preprocessor (0x01 / 0x02).
//
// Note: use "string" literals (not 'char') in alternations with '..'
// ranges to avoid a pest parser bug.

// ═══════════════════════════════════════════════════════════════════════
// 1. Whitespace & Comments
// ═══════════════════════════════════════════════════════════════════════

WHITESPACE = _{ " " | "\t" | COMMENT }
COMMENT = _{ "#" ~ (!("\n" | "\r") ~ ANY)* }

// Injected by the Rust indentation preprocessor.
indent  = @{ "\u{0001}" }
dedent  = @{ "\u{0002}" }
newline = @{ "\n" | "\r\n" | "\r" }

// ═══════════════════════════════════════════════════════════════════════
// 2. Terminals — numbers, strings, identifiers
// ═══════════════════════════════════════════════════════════════════════

// -- identifiers -------------------------------------------------------
name = @{ name_first ~ name_char* }
    name_first = _{ 'a'..'z' | 'A'..'Z' | "_" }
    name_char  = _{ 'a'..'z' | 'A'..'Z' | '0'..'9' | "_" }

identifier = { name }

// -- numbers -----------------------------------------------------------
num = { float | imag | hex | oct | bin | dec }

dec = @{ nonzero_dec | "0" }
    nonzero_dec = @{ '1'..'9' ~ digit_cont* }
    digit_cont  = @{ "_"? ~ '0'..'9' }

float = @{ float_inner }
    float_inner = {
          dec ~ "." ~ dec ~ exp?
        | dec ~ exp
        | "." ~ dec ~ exp?
    }
    exp = @{ ("e" | "E") ~ ("+" | "-")? ~ dec }

imag = @{ imag_inner }
    imag_inner = { (float | dec) ~ ("j" | "J") }

hex = @{ "0" ~ ("x" | "X") ~ hex_part+ }
    hex_part  = @{ "_"? ~ hex_digit }
    hex_digit = _{ '0'..'9' | 'a'..'f' | 'A'..'F' }

oct = @{ "0" ~ ("o" | "O") ~ oct_part+ }
    oct_part  = @{ "_"? ~ oct_digit }
    oct_digit = _{ '0'..'7' }

bin = @{ "0" ~ ("b" | "B") ~ bin_part+ }
    bin_part  = @{ "_"? ~ bin_digit }
    bin_digit = _{ '0'..'1' }

// -- strings -----------------------------------------------------------
string = { long_string | short_string }

short_string = @{
      ("\"" ~ (!("\"" | "\\" | "\n") ~ ANY | esc_seq)* ~ "\"")
    | ("'"  ~ (!("'"  | "\\" | "\n") ~ ANY | esc_seq)* ~ "'")
    }

long_string = @{
      ("\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\"")
    | ("'''"    ~ (!"'''"    ~ ANY)* ~ "'''")
    }

esc_seq = @{ "\\" ~ ANY }

// -- f-strings (Python compatible) ---------------------------------------
f_string = @{ ("f" | "F") ~ (short_string | long_string) }

// -- dollar holes (Nomi lambdas) ---------------------------------------
dollar_hole = @{ "$" ~ ('0'..'9')+ }
dollar_name = @{ "$" ~ name_first ~ name_char* }

// ═══════════════════════════════════════════════════════════════════════
// 3. Expressions — precedence encoded in rule depth
// ═══════════════════════════════════════════════════════════════════════

// -- special Nomi expression forms + conditional -----------------------
// Try specific expression forms first, then fall to general expressions.
test = {
      func_expr | match_inline | match_block_expr
    | assign_expr | try_expr
    | pipe_expr ~ ("if" ~ or_test ~ "else" ~ test)?
    }

// -- pipeline |>, composition >>>, <<< ----------------------------------
pipe_expr = { compose_expr ~ ("|>" ~ compose_expr)* }

compose_expr = { or_test ~ (compose_op ~ or_test)* }
    compose_op = _{ ">>>" | "<<<" }

// -- logical or ---------------------------------------------------------
or_test = { nullish_expr ~ ("or" ~ nullish_expr)* }

// -- nullish ?? ---------------------------------------------------------
nullish_expr = { and_test ~ ("??" ~ and_test)* }

// -- logical and --------------------------------------------------------
and_test = { not_test ~ ("and" ~ not_test)* }

// -- not ----------------------------------------------------------------
not_test = { "not" ~ not_test | comparison }

// -- comparisons (chained: a < b < c) -----------------------------------
comparison = { range_expr ~ (comp_item ~ range_expr)* }
    comp_item = {
          "<="  | ">=" | "==" | "!=" | "<>"
        | "in" | ("not" ~ "in") | "is" ~ ("not")? | "is"
        | "<"   | ">"
    }

// -- ranges: start..end, start..<end  (with optional by step) -----------
range_expr = { bin_expr ~ (range_op ~ bin_expr ~ ("by" ~ bin_expr)?)? }
    range_op = _{ "..<" | ".." }

// -- binary expression --------------------------------------------------
bin_expr = { factor ~ (bin_op ~ factor)* }
    bin_op = _{ "|" | "^" | "&" | "<<" | ">>" | "+" | "-"
              | "*" | "@" | "//" | "/" | "%" }

// -- unary / power ------------------------------------------------------
factor = { unary | power }
    unary = { ("+" | "-" | "~") ~ factor }
power = { await_expr ~ ("**" ~ factor)? }
await_expr = { "await"? ~ atom_postfix }

// -- postfix chain (call, subscript, attribute, safe variants) ----------
atom_postfix = { atom ~ postfix* }
postfix = {
      call      | subscript      | getattr
    | safe_call | safe_getattr   | safe_getitem
    }

call  = { "(" ~ arguments? ~ ")" }
subscript = { "[" ~ subscriptlist ~ "]" }
getattr = { "." ~ identifier }
safe_call = { "?." ~ identifier ~ "(" ~ arguments? ~ ")" }
safe_getattr = { "?." ~ identifier }
safe_getitem = { "?." ~ "[" ~ subscriptlist ~ "]" }

// -- atoms (literals, names, groups, etc.) ------------------------------
atom = {
      paren   | brack  | brace
    | dollar_hole | dollar_name
    | f_string | num     | string
    | const_none  | const_true | const_false
    | ellipsis
    | identifier
    }

paren       = { "(" ~ paren_inner ~ ")" }
brack       = { "[" ~ brack_inner ~ "]" }
brace       = { "{" ~ brace_inner ~ "}" }
ellipsis    = { "..." }
const_none  = { "None" }
const_true  = { "True" }
const_false = { "False" }

// -- parenthesized content ----------------------------------------------
paren_inner = {
      yield_expr
    | section
    | tuple_inner
    | test
    | ""  // empty tuple ()
    }

brack_inner = {
      list_comprehension
    | list_items
    | ""  // empty list []
    }

brace_inner = {
      dict_comprehension
    | set_comprehension
    | dict_items
    | set_items
    | ""  // empty dict/set {}
    }

// -- tuple --------------------------------------------------------------
tuple_inner = { test_or_star ~ ("," ~ test_or_star)+ ~ ","? }

// -- list / set items ---------------------------------------------------
list_items = { test_or_star ~ ("," ~ test_or_star)* ~ ","? }
set_items  = { test ~ ("," ~ test)* ~ ","? }

// -- dict items ---------------------------------------------------------
dict_items = { (key_value | "**" ~ test) ~ ("," ~ (key_value | "**" ~ test))* ~ ","? }
key_value  = { test ~ ":" ~ test }

// -- comprehensions -----------------------------------------------------
list_comprehension = { test_or_star ~ comp_fors ~ comp_if? }
dict_comprehension = { key_value ~ comp_fors ~ comp_if? }
set_comprehension  = { test ~ comp_fors ~ comp_if? }
comp_fors = { comp_for+ }
comp_for  = { "async"? ~ "for" ~ star_targets ~ "in" ~ or_test }
comp_if   = { "if" ~ test_nocond }

// -- star expr ----------------------------------------------------------
star_expr = { "*" ~ test }
test_or_star = { star_expr | test }
exprlist = { (test | star_expr) ~ ("," ~ (test | star_expr))* ~ ","? }

// -- section: (+1), (2*), (+) -------------------------------------------
section = {
      section_op ~ test
    | test ~ section_op
    | section_op
    }
    section_op = _{ "+" | "-" | "*" | "/" | "//" | "%" | "**" }

// -- subscript ----------------------------------------------------------
subscriptlist = { sub_item ~ ("," ~ sub_item)* ~ ","? }
sub_item = { slice | test }
slice = { test? ~ ":" ~ test? ~ sliceop? }
sliceop = { ":" ~ test? }

// -- yield --------------------------------------------------------------
yield_expr = { "yield" ~ ("from" ~ test)? ~ testlist? }

// -- func arrow expr: (a,b) => body, x => body --------------------------
func_expr = {
      "(" ~ parameters? ~ ")" ~ "=>" ~ test ~ ("->" ~ test)?
    | identifier ~ "=>" ~ test ~ ("->" ~ test)?
    }

// -- assign expr: name := value (walrus) --------------------------------
assign_expr = { identifier ~ ":=" ~ test }

// -- try expression: try body except E as e: handler --------------------
try_expr = { "try" ~ test ~ try_except_clause+ }
try_except_clause = { "except" ~ identifier ~ ("as" ~ identifier)? ~ ":" ~ test }

// -- inline match: match val: case 1 => "one"; case _ => "many" ---------
match_inline = { "match" ~ test ~ ":" ~ case_expr ~ (";" ~ case_expr)* ~ ";"? }
case_expr = { "case" ~ pattern ~ ("if" ~ test)? ~ "=>" ~ test }

// -- block match expression ---------------------------------------------
match_block_expr = { "match" ~ test ~ ":" ~ newline ~ indent ~ case_block_expr+ ~ newline* ~ dedent ~ newline* }
case_block_expr = {
      "case" ~ pattern ~ ("if" ~ test)? ~ ":" ~ test ~ newline
    | "case" ~ pattern ~ ("if" ~ test)? ~ body_block
    }

// -- test_nocond (no ternary) -------------------------------------------
test_nocond = { or_test }

// -- test lists ---------------------------------------------------------
testlist = { test ~ ("," ~ test)* ~ ","? }

// ═══════════════════════════════════════════════════════════════════════
// 4. Patterns (for match/case)
// ═══════════════════════════════════════════════════════════════════════

pattern = { sequence_pattern | as_pattern }

sequence_pattern = { sequence_item ~ "," ~ sequence_rest }
    sequence_rest = { (sequence_item ~ ("," ~ sequence_item)* ~ ","?)? }

as_pattern = { or_pattern ~ ("as" ~ identifier)? }

or_pattern = { closed_pattern ~ ("|" ~ closed_pattern)* }

closed_pattern = {
      literal_pattern
    | wildcard
    | attr_pattern
    | "(" ~ as_pattern ~ ")"
    | "[" ~ sequence_items ~ "]"
    | "(" ~ sequence_items ~ ")"
    | "{" ~ mapping_items ~ "}"
    | "{" ~ mapping_star ~ "}"
    | class_pattern
    | capture_or_constrained
    }
    wildcard   = { "_" ~ !name_char }
    capture_or_constrained = { identifier ~ (":" ~ test)? }

literal_pattern = {
      const_none | const_true | const_false
    | string     | num
    }

attr_pattern = { identifier ~ ("." ~ identifier)+ }

class_pattern = { name_or_attr ~ "(" ~ arguments_pattern? ~ ","? ~ ")" }
    name_or_attr = { identifier ~ ("." ~ identifier)* }

arguments_pattern = {
      pos_arg_pattern ~ ("," ~ keyws_arg_pattern)?
    | keyws_arg_pattern
    }
    pos_arg_pattern  = { as_pattern ~ ("," ~ as_pattern)* }
    keyws_arg_pattern = { keyw_arg_pattern ~ ("," ~ keyw_arg_pattern)* }
    keyw_arg_pattern  = { identifier ~ "=" ~ as_pattern }

sequence_item = { star_pattern | as_pattern }
    star_pattern = { "*" ~ identifier }

sequence_items = { (sequence_item ~ ("," ~ sequence_item)* ~ ","?)? }

mapping_items = { (mapping_item_pattern ~ ("," ~ mapping_item_pattern)* ~ ","?)? }
    mapping_item_pattern = { (literal_pattern | attr_pattern) ~ ":" ~ as_pattern }

mapping_star = { (mapping_item_pattern ~ ("," ~ mapping_item_pattern)* ~ ",")?
                 ~ "**" ~ identifier ~ ","? }

// ═══════════════════════════════════════════════════════════════════════
// 5. Statements
// ═══════════════════════════════════════════════════════════════════════

stmt = { simple_stmt | compound_stmt | block_call_stmt }

simple_stmt = {
      (small_stmt ~ (";" ~ small_stmt)* ~ ";"? ~ newline)
    | (flow_stmt ~ postfix_test? ~ newline)
    | (small_stmt ~ "where" ~ suite)
    | (small_stmt ~ "where" ~ small_stmt ~ newline)
    | match_block_simple
    }
    postfix_test = { "if" ~ test | "unless" ~ test }

small_stmt = {
      type_alias | func_equation | defer_stmt
    | assign_stmt | del_stmt
    | flow_stmt | pass_stmt | import_stmt
    | global_stmt | nonlocal_stmt | assert_stmt
    | expr_stmt  // bare expression — must be last
    }

match_block_simple = {
      testlist_star_expr ~ "=" ~ match_block_expr
    | "return" ~ match_block_expr
    }

// -- simple statements --------------------------------------------------
expr_stmt     = { testlist_star_expr }
pass_stmt     = { "pass" }
break_stmt    = { "break" }
continue_stmt = { "continue" }
return_stmt   = { "return" ~ testlist? }
raise_stmt    = { "raise" ~ (test ~ ("from" ~ test)?)? }
global_stmt   = { "global" ~ identifier ~ ("," ~ identifier)* }
nonlocal_stmt = { "nonlocal" ~ identifier ~ ("," ~ identifier)* }
assert_stmt   = { "assert" ~ test ~ ("," ~ test)? }
del_stmt      = { "del" ~ exprlist }

flow_stmt = {
      break_stmt | continue_stmt | return_stmt
    | raise_stmt | yield_stmt
    }

yield_stmt = { yield_expr }

// -- imports ------------------------------------------------------------
import_stmt = { import_name | import_from }
import_name = { "import" ~ dotted_as_names }
import_from = { "from" ~ (dots? ~ dotted_name | dots) ~ "import"
                ~ ("*" | "(" ~ import_as_names ~ ")" | import_as_names) }
    dots = @{ "."+ }
    import_as_name  = { identifier ~ ("as" ~ identifier)? }
    dotted_as_name  = { dotted_name ~ ("as" ~ identifier)? }
    import_as_names  = { import_as_name ~ ("," ~ import_as_name)* ~ ","? }
    dotted_as_names  = { dotted_as_name ~ ("," ~ dotted_as_name)* }
    dotted_name      = { identifier ~ ("." ~ identifier)* }

// -- assignment ---------------------------------------------------------
assign_stmt = { annassign | augassign | assign }

annassign = { testlist_star_expr ~ ":" ~ constraint_list ~ ("=" ~ test)? }

assign = { testlist_star_expr ~ ("=" ~ (yield_expr | testlist_star_expr))+ }

augassign = { testlist_star_expr ~ aug_op ~ (yield_expr | testlist) }
    aug_op = _{ "+=" | "-=" | "*=" | "@=" | "/=" | "%=" | "&="
              | "|=" | "^=" | "<<=" | ">>=" | "**=" | "//=" }

testlist_star_expr = {
      test_or_star ~ ("," ~ test_or_star)+ ~ ","?
    | test_or_star ~ ","
    | test_or_star
    }

// -- constraints --------------------------------------------------------
constraint_list = {
      constraint_item ~ ("," ~ constraint_item)+ ~ ","?
    | constraint_item
    }
constraint_item = {
      test ~ "else" ~ string
    | test
    }

// -- type alias (Nomi) --------------------------------------------------
type_alias = { "type" ~ identifier ~ "=" ~ test }

// -- defer (Nomi) --------------------------------------------------------
defer_stmt = { "defer" ~ (expr_stmt | assign_stmt) }

// -- function equation (Nomi): f(a,b) = expr, sq x = x * x --------------
func_equation = {
      call_head ~ "when" ~ test ~ "=" ~ test ~ ("->" ~ test)?
    | identifier ~ identifier ~ "when" ~ test ~ "=" ~ test ~ ("->" ~ test)?
    | call_head ~ "=" ~ test ~ ("->" ~ test)?
    | identifier ~ identifier ~ "=" ~ test ~ ("->" ~ test)?
    }
    call_head = { atom ~ "(" ~ arguments? ~ ")" }

// ═══════════════════════════════════════════════════════════════════════
// 6. Compound Statements
// ═══════════════════════════════════════════════════════════════════════

compound_stmt = {
      funcdef | async_funcdef | classdef | if_stmt | guard_stmt
    | unless_stmt | while_stmt | for_stmt | try_stmt | match_stmt
    | with_stmt | decorated | data_decl
    }

// -- funcdef: func name(params): suite ----------------------------------
funcdef = { "func" ~ identifier ~ "(" ~ parameters? ~ ")" ~ ("->" ~ test)? ~ suite }
async_funcdef = { "async" ~ funcdef }

// -- classdef -----------------------------------------------------------
classdef = { "class" ~ identifier ~ ("(" ~ arguments? ~ ")")? ~ suite }

// -- decorator ----------------------------------------------------------
decorator = { "@" ~ dotted_name ~ ("(" ~ arguments? ~ ")")? ~ newline }
decorators = { decorator+ }
decorated = { decorators ~ (classdef | funcdef | async_funcdef) }

// -- if / unless --------------------------------------------------------
if_stmt = {
      "if" ~ pattern ~ "=" ~ test ~ suite ~ ("else" ~ suite)?
    | "if" ~ test ~ suite ~ elifs ~ ("else" ~ suite)?
    }
elifs = { elif_* }
elif_ = { "elif" ~ test ~ suite }

guard_stmt = { "guard" ~ pattern ~ "=" ~ test ~ suite }

unless_stmt = { "unless" ~ test ~ suite }

// -- while / for --------------------------------------------------------
while_stmt = {
      "while" ~ pattern ~ "=" ~ test ~ suite
    | "while" ~ test ~ suite ~ ("else" ~ suite)?
    }

for_stmt = { "for" ~ star_targets ~ "in" ~ testlist ~ suite ~ ("else" ~ suite)? }

// Loop-variable targets — restricted to avoid consuming 'in' as a comparison op.
star_targets = { star_target ~ ("," ~ star_target)* ~ ","? }
star_target = { star_expr | target_atom }
target_atom = {
      "(" ~ star_targets ~ ")"
    | "[" ~ star_targets ~ "]"
    | identifier
    }

// -- try ----------------------------------------------------------------
try_stmt = {
      "try" ~ suite ~ except_clauses ~ ("else" ~ suite)? ~ finally?
    | "try" ~ suite ~ finally
    }
finally = { "finally" ~ suite }
except_clauses = { except_clause+ }
except_clause = { "except" ~ (test ~ ("as" ~ identifier)?)? ~ suite }

// -- with ---------------------------------------------------------------
with_stmt = { "with" ~ with_items ~ suite }
with_items = { with_item ~ ("," ~ with_item)* }
with_item = { test ~ ("as" ~ identifier)? }

// -- match statement ----------------------------------------------------
match_stmt = { "match" ~ test ~ ":" ~ newline ~ indent ~ case_stmt+ ~ dedent ~ newline* }
case_stmt = { "case" ~ pattern ~ ("if" ~ test)? ~ ":" ~ body }

// -- data declaration (Nomi) --------------------------------------------
data_decl = { "data" ~ identifier ~ ":" ~ newline ~ indent ~ data_field+ ~ newline* ~ dedent ~ newline* }
data_field = { identifier ~ (":" ~ test)? ~ ("where" ~ test)? ~ newline }

// ═══════════════════════════════════════════════════════════════════════
// 7. Block Call (Nomi)
// ═══════════════════════════════════════════════════════════════════════

block_call_stmt = { call_head ~ ("->" ~ testlist_star_expr)? ~ suite }

// ═══════════════════════════════════════════════════════════════════════
// 8. Shared Helpers
// ═══════════════════════════════════════════════════════════════════════

suite = { simple_suite | suite_body }
    simple_suite = { ":" ~ simple_stmt }
    // newline* after dedent consumes the trailing newline of the DEDENT-only
    // line so that continuation clauses (else, elif, except, finally) are
    // visible to the parent compound statement.
    suite_body    = { ":" ~ newline ~ indent ~ (stmt | newline)+ ~ newline* ~ dedent ~ newline* }

// Body without leading colon — for match case, data fields, etc.
body = { simple_stmt | body_block }
    body_block = { newline ~ indent ~ (stmt | newline)+ ~ newline* ~ dedent ~ newline* }

// Parameters
parameters = { params_main | starparams | kwparams }
    params_main = {
          paramvalue ~ ("," ~ paramvalue)*
            ~ ("," ~ slash)? ~ ("," ~ starparams)? ~ ("," ~ kwparams)?
    }
    slash = { "/" ~ ("," ~ paramvalue)* }
    starparams = { (starparam | starguard) ~ poststarparams }
    starparam  = { "*" ~ typedparam }
    starguard  = { "*" }
    poststarparams = { ("," ~ paramvalue)* ~ ("," ~ kwparams)? }
    kwparams   = { "**" ~ typedparam ~ ","? }
    paramvalue = { typedparam ~ ("=" ~ test)? }
    typedparam = { identifier ~ (":" ~ param_constraint)? }
    param_constraint = { "(" ~ constraint_list ~ ")" | constraint_item }

// Arguments
arguments = { args_main | starargs | kwargs | comprehension_arg }
    args_main = {
          argvalue ~ ("," ~ argvalue)* ~ ("," ~ (starargs | kwargs))?
    }
    comprehension_arg = { test ~ comp_fors ~ comp_if? }
    starargs  = { stararg ~ ("," ~ stararg)* ~ ("," ~ argvalue)* ~ ("," ~ kwargs)? }
    stararg   = { "*" ~ test }
    kwargs    = { "**" ~ test ~ ("," ~ argvalue)* }
    argvalue  = { test ~ ("=" ~ test)? }

// ═══════════════════════════════════════════════════════════════════════
// 9. Top Level
// ═══════════════════════════════════════════════════════════════════════

file_input = { SOI ~ (stmt | newline)* ~ EOI }
