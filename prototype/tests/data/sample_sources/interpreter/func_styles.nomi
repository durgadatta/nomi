# Nomi function definition styles — comprehensive sample
# Shows: funcdef, arrow, equation, piecewise, underscore lambdas, where

# ── 1. classic funcdef ────────────────────────────────────────────
func classic_add(a, b):
    return a + b

# ── 2. arrow expression (anonymous lambda) ─────────────────────────
arrow_square = (x) => x * x

# ── 3. lightweight equation f(a,b) = expr ─────────────────────────
add(a, b) = a + b
pi() = 3.14
greet(name) = "Hello, " + name

# ── 4. piecewise (Haskell-style pattern matching) ──────────────────
fact(1) = 1
fact(n) = fact(n - 1) * n

fib(0) = 0
fib(1) = 1
fib(n) = fib(n - 1) + fib(n - 2)

# ── 5. underscore hole-filling lambdas ─────────────────────────────
double = _ * 2
upcase = _.upper()
get_name = _["name"]
add_two = _ + _

# ── 6. where clause — local bindings ───────────────────────────────
# simple: compute with helpers
area = pi * r * r where:
    pi = 3.14159
    r = 5

# mixed: where + underscore hole
scaled_double = scale_value where:
    scale = _ * 3
    scale_value = scale(7)

# mixed: where + equation
greeting(name) = prefix + name where:
    prefix = "Hello, "

# mixed: where + local function definition
sum_squares(x, y) = s(x) + s(y) where:
    s(n) = n * n

# mixed: where cascading helpers
stats = (total, avg) where:
    data = [2, 4, 6, 8]
    total = sum(data)
    avg = total / len(data)


# ── 7. operator sections (Haskell-style) ─────────────────────────────
plus_two = (+2)          # (x) => x + 2
times_two = (2*)         # (x) => 2 * x
plus = (+)               # (x, y) => x + y

scaled = list(map((2*), [1, 2, 3]))


result_classic = classic_add(1, 2)
print("1. classic func:        1 + 2 = " + str(result_classic))

result_arrow = arrow_square(5)
print("2. arrow (x)=>x*x:      5^2  = " + str(result_arrow))

result_eq = add(3, 4)
print("3. equation:            3 + 4 = " + str(result_eq))

result_pi = pi()
print("3. no-params:           pi() = " + str(result_pi))

result_greet = greet("world")
print("3. param:               greet(world) = " + result_greet)

result_fact5 = fact(5)
print("4. piecewise fact(5):   5!  = " + str(result_fact5))

result_fib6 = fib(6)
print("4. piecewise fib(6):    fib = " + str(result_fib6))

result_double = double(21)
print("5. hole _ * 2:          21*2 = " + str(result_double))

result_upcase = upcase("hello")
print("5. hole _.upper():      HELLO = " + result_upcase)

result_get = get_name({"name": "alice"})
print("5. hole _[\"name\"]:       alice = " + result_get)

result_addtwo = add_two(10, 20)
print("5. hole _ + _:          10+20 = " + str(result_addtwo))

print("6. where area:          pi*r^2 = " + str(area))
print("6. where + hole:       7*3    = " + str(scaled_double))
r = greeting("where")
print("6. where + equation:   Hello, where = " + r)
result_sq = sum_squares(3, 4)
print("6. where + local fn:   3^2+4^2 = " + str(result_sq))
print("6. where cascade:      stats  = " + str(stats))

result_plus2 = plus_two(5)
result_double2 = times_two(10)
result_plus = plus(30, 40)
print("7. op section (+2):     (+2)(5) = " + str(result_plus2))
print("7. op section (2*):     (2*)(10) = " + str(result_double2))
print("7. op section (+):      (+)(30,40) = " + str(result_plus))
print("7. op section map:      " + str(scaled))

