'''
Implemented compatibility behavior; target block decisions are in docs/design/decisions.md
'''


func times(n):
    for i in range(n):
        yield 
a = 1

times(2): 
    a = a + 1
    print('hello')


func retry(max_times, exc=None):
    if exc is None:
        exc = Exception 

    for i in range(max_times):
        try:
            yield  # Execute the block here
            # If we reach here, block succeeded
            print(f'successful after {i+1} attempts')
            return  # Exit on success
        except exc as e:
            print(f'failed: attempt={i+1}, error: {e}')
            # Continue to next attempt
    
    print(f'All {max_times} attempts failed!')
    

retry(3):
    1/0
    

# block that receive parameter
func each(items):
    for item in items:
        yield item


# just for demo, unpacking of yield values avoids
# the need for this
func each_key_val(data_dict):
    for key,val in data_dict.items():
        yield key, val


    
# NOMI-SUBSTRATE-011: keep block parameters aligned with the shared
# BindingTarget model. Today this fixture documents exact positional mapping
# from yielded values to block parameters.
each([1,2,3]) -> item:
    print(f'each {item}')

each_key_val({"one":1, "two":2}) -> key, val:
    print(f"each_key_val {key=}, {val=}")


#parameter behave like assignment (unlike args-> param in func)
# this avoids the need to have each_key_val as a separate func
each({"one":1, "two":2}.items()) -> key, val:
    print(f"each {key=}, {val=}")
