from contextlib import contextmanager 

func is_positive(x):
    return 0 < x

func add(a,b):
    return a + b

v:int, is_positive, v>1 = add(1, 2)


# this still is not working; resume one the special_cases.py
# passes the functional test after uncommenting
@contextmanager
func error_printer():
    try:
        yield 
    except Exception as e:
        print(f"An error occurred: {e}")

class ErrorPrinter:
    func __enter__(self):
      return self 
   
    func __exit__(self, exc_type, exc_val, exc_tb):
      if exc_val:
         print(f"An error occurred: {exc_val}")
         return True # so the the exception is suppressed
    
func double_limited_pos(a:(is_positive, 1<a<100)):
    return a*2

error_printer = ErrorPrinter()
with error_printer:
    a:is_positive, 20<a<30 = 10

with error_printer:
    v = double_limited_pos(-1)

doubled_5 = double_limited_pos(5)



print(v)

