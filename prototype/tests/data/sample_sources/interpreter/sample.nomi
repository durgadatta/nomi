from contextlib import contextmanager 

fun is_positive(x):
    return 0 < x

fun add(a,b):
    return a + b

v:int, is_positive, v>1 = add(1, 2)

@contextmanager
fun _error_printer():
    try:
        yield 
    except Exception as e:
        print(f"An error occurred: {e}")

error_printer = _error_printer()


with error_printer:
    a:is_positive, 20<a<30 = 10


print(v)

