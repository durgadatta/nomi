# Status: target-only research candidate; fictional lab APIs, not runnable.
# Experiment DW5: docs/research/data_workflows/nomi_candidates.md
from lab.models import FeatureBatch, FittedModel, ModelError, ModelSpec
from lab.models import PredictionBatch, TrainingSplit, models

func train(
    spec: ModelSpec,
    split: TrainingSplit,
    seed: Int,
) -> Result[FittedModel, ModelError]:
    training = models.training_rows(split)
    identity = models.training_identity(split)
    return models.fit(spec, training, seed=seed, partition=identity)

func predict(
    learned: FittedModel,
    held_out: FeatureBatch,
) -> Result[PredictionBatch, ModelError]:
    return models.predict(learned, held_out)

# Proposed synchronous owned-data calls. ModelError unifies schema/fit errors.
# fit sees training rows, not the complete split; preprocessing learns there too.
# predict never updates learned state or refits preprocessing.
# Fitted evidence carries feature schema, training identity, seed and environment.
# Seed alone is NOT a cross-backend reproducibility guarantee.
# Required oracle: adding an outlier only to held-out rows cannot change the
# fitted training scaler; changing feature schema rejects prediction.
# Choosing a bad temporal split remains a modeling error, not repaired by syntax.


# Physics continuation: docs/design/scientific_discovery.md, SP1/SP2.
# Fictional ordinary constructors/checker calls; not runnable or typechecked.
# Inputs are named symbolic expressions, not numeric bindings or a live solver.
from lab.science import ClaimEvidence, Expression, MathematicalModel
from lab.science import ScienceError, Symbol, Theory, claims, expressions


func check_oscillator_energy(
    model: MathematicalModel,
    theory: Theory,
    time: Symbol,
    displacement: Expression,
    mass: Expression,
    stiffness: Expression,
) -> Result[ClaimEvidence, ScienceError]:
    velocity = expressions.derivative(displacement, variable=time, theory=theory)?
    speed_squared = expressions.multiply(velocity, velocity, theory=theory)?
    displacement_squared = expressions.multiply(displacement, displacement, theory=theory)?
    kinetic_twice = expressions.multiply(mass, speed_squared, theory=theory)?
    potential_twice = expressions.multiply(stiffness, displacement_squared, theory=theory)?
    energy_twice = expressions.add(kinetic_twice, potential_twice, theory=theory)?
    half = expressions.rational(1, 2, theory=theory)?
    energy = expressions.multiply(half, energy_twice, theory=theory)?
    energy_rate = expressions.derivative(energy, variable=time, theory=theory)?
    conservation = claims.zero(energy_rate, model=model, theory=theory)?
    return claims.check(conservation, premises=model.relations, theory=theory)


# Contract: every returned expression is engine-free, context-qualified and
# referable. An Expression result says it is well formed, not that a theorem
# about it has been proved. rational constructs exact expression data; it does
# not change the admitted ordinary Int division contract.
# This claim needs constant m,k, a real C2 displacement and the undamped,
# unforced dynamics relation m*D_t^2(x) + k*x = 0. All are retained premises.
# ClaimEvidence can remain unknown/conditional; an Ok receipt is NOT a proof
# of conservation or empirical validity. No observations or solver run occur.
# Negative pressure: time substituted for displacement fails space checking;
# same-spelled symbols from different binders are not interchangeable;
# revising dynamics to include damping invalidates the conservation receipt;
# missing regularity remains an obligation rather than a guessed derivative.
# Numerical trajectories, observation uncertainty and inverse identification
# require separate qualified evidence as specified by SP3/SP4.


# AI framework continuation: docs/design/ai_frameworks.md, AF1/AF2.
# Fictional pure expression API, not source-checkout probe exports or runnable.
from lab.numeric import NumericError, NumericProgram, NumericTheory, TensorExpression
from lab.numeric import numeric


func describe_linear_loss(
    features: TensorExpression,
    weights: TensorExpression,
    bias: TensorExpression,
    target: TensorExpression,
    theory: NumericTheory,
) -> Result[NumericProgram, NumericError]:
    projection = numeric.matmul(features, weights, theory=theory)?
    bias_batch = numeric.broadcast(bias, axes=projection.axes, theory=theory)?
    prediction = numeric.add(projection, bias_batch, theory=theory)?
    residual = numeric.subtract(prediction, target, theory=theory)?
    squared_error = numeric.square(residual, theory=theory)?
    loss = numeric.mean(squared_error, axes=squared_error.axes, theory=theory)?
    return numeric.program("linear-loss", outputs=[prediction, loss], theory=theory)


# A tensor expression is referable description data, not a concrete buffer.
# features: batch x features; weights: features x outputs; bias: outputs;
# target: batch x outputs. Extent equality alone cannot establish axis identity.
# Broadcast, reduction denominator, scalar policy and program closure are
# explicit library contracts; constructing this program performs no training.
# Negative pressure: weights indexed by equal-size tokens refuse contraction;
# omitted broadcast refuses add; target dtype/axes mismatch refuses subtraction;
# host callbacks or foreign captured buffers cannot enter a checked program.
# A future transformation needs independent primal/derivative/batching rules.
# Backend metadata coverage does not validate kernels or mint device grants.
