# Status: target-only research candidate; not runnable or typechecked.
# Evidence: docs/research/data_workflows/source_forms.md
# Proposed std collection contracts; exact Int meaning is accepted, capacity is
# a separate backend admission gate. No runtime conformance is claimed here.
# Composition continuation: docs/design/synthesis.md
# Policy oracle: docs/research/data_workflows/nomi_candidates.md
from std.collections import filter, fold, map

data Sale:
    order_id: Text
    customer: Text
    quantity: Int where quantity >= 0
    unit_price_minor: Int where unit_price_minor >= 0

func total(rows: List[Sale]) -> Int:
    return rows
        |> filter((row) => row.quantity > 0)
        |> map((row) => row.quantity * row.unit_price_minor)
        |> fold(0, (sum, amount) => sum + amount)

example "eager arithmetic before any table planner":
    rows = [
        Sale(order_id="A", customer="north", quantity=2, unit_price_minor=400),
        Sale(order_id="B", customer="south", quantity=1, unit_price_minor=700),
        Sale(order_id="C", customer="north", quantity=3, unit_price_minor=200),
    ]
    check total(rows) == 2100

# Calls evaluate now. |> only inserts the first argument.
# No assumed SQL translation, laziness, parallelism or callback quotation.


# An application acceptance predicate does not redefine equality or key identity.
# This ordinary function is target-only; no comparison library API is assumed.
func within_amount_policy(
    left: Int,
    right: Int,
    tolerance: Int where tolerance >= 0,
) -> Bool:
    if left <= right:
        return right - left <= tolerance
    return left - right <= tolerance

example "retain exact differences under an explicit acceptance policy":
    check 200 != 250
    check within_amount_policy(200, 250, 50)
    check not within_amount_policy(200, 250, 49)
    check within_amount_policy(250, 200, 50)
    check within_amount_policy(200, 200, 0)

example "pairwise tolerance is not a transitive key relation":
    check within_amount_policy(0, 40, 50)
    check within_amount_policy(40, 80, 50)
    check not within_amount_policy(0, 80, 50)

# Negative oracle: tolerance -1 fails the parameter constraint before the body;
# no Bool verdict is produced. Untrusted policy input instead needs decode.
# Do not infer a hash/equality implementation, clustering or automatic rounding
# from this predicate. A streamed prefix also cannot prove complete comparison.
