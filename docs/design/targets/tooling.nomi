# Status: target-only category fixture; not runnable today.
# Comparison: docs/research/features/modules_tooling.md

data Interval:
    start: Int
    end: Int
    where end >= start note "end must not precede start"

func duration(interval: Interval) -> Int:
    return interval.end - interval.start

example "an example is both documentation and an isolated check":
    interval = Interval(start=3, end=8)
    check duration(interval) == 5

