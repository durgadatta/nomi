# Status: target-only category fixture; not runnable today.
# Comparison: docs/research/features/collections.md
from std.collections import filter, fold, map, sort_by

data Line:
    label: Text
    quantity: Int where quantity >= 0
    unit_price: Int where unit_price >= 0

func total(lines: List[Line]) -> Int:
    return lines
        |> map((line) => line.quantity * line.unit_price)
        |> fold(0, (sum, value) => sum + value)

example "strict collection flow has a predictable result":
    lines = [
        Line(label="tea", quantity=2, unit_price=4),
        Line(label="cup", quantity=1, unit_price=7),
    ]
    check total(lines) == 15
    labels = lines
        |> filter((line) => line.quantity > 1)
        |> sort_by((line) => line.label)
        |> map((line) => line.label)
    check labels == ["tea"]

# fold contract here: fold(values, initial, combine); left-to-right, once/item.
# The pipeline introduces no laziness, parallelism, filtering, or failure.
# Stream and TablePlan APIs must declare consumption/execution separately.
# Open experiment: joins/windows with explicit expression values versus scoped
# query notation. No SQL keyword or generator spelling is introduced here.
