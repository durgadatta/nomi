# Status: aspirational first-product fixture, not runnable or typechecked.
# Packet: docs/research/features/README.md; docs/design/synthesis.md;
# docs/review/2026-09-29-language-synthesis.md
# Category map: docs/design/targets/README.md
#
# Story: paste a small JSON batch, validate it, select eligible rows, inspect
# a report, repair bad input, and reuse the same pure function from the CLI.
# Input/output transport belongs to an explicit host adapter. This module
# neither opens files nor starts network requests or background tasks.
# Resource and concurrent-job pressure remains in resources.nomi,
# concurrency.nomi and ../resource_lifetime_target.nomi.
#
# Proposed library contracts, not current exports:
# json.parse -> Result[Value, JsonError], without numeric rounding;
# BatchInput.decode -> Result[BatchInput, DecodeErrors], strict fields and
# accumulated independent errors with original input paths;
# json.encode(derived-codec data) -> Result[Text, EncodeError];
# map/filter and Result.map_error use synchronous non-retaining pure callbacks.
# These closed uses need checked library contracts, not user generic syntax.
#
# Preserve input order and duplicate IDs: each row is an observation, not an
# update to a unique customer registry. No deduplication or merging is implied.
# The 128-row limit is a domain rule, not a byte/depth/work/output budget.
# Runner limits and scalar/text/codec rules must close before sample promotion.

from std.collections import filter, map
from std.data import DecodeErrors, Value
from std.json import EncodeError, JsonError, json


# Inferred checked interface pressure: () -> Int, no world effects.
# Consumers must not execute this function or inspect private code to use its
# verified public contract. The current prototype does not export that proof.
pub func maximum_batch_size():
    return 128

# Negative checked-boundary pressure (exploration may retain the unknown):
# pub func external_score(value): return unknown_dependency(value)
# A selected closed/pure policy must explain the unresolved dependency;
# a caller's concrete argument cannot establish a public contract or purity.


pub data CustomerId:
    value: Text where value.trim() != ""

pub data Customer:
    id: CustomerId
    name: Text where name.trim() != ""
    age: Int where age >= 0

# Trimming preserves these exact nonempty predicates. A different transform
# needs another validation step if it can invalidate a predicate.
data CustomerInput:
    id: Text where id.trim() != ""
    name: Text where name.trim() != ""
    age: Int where age >= 0

data BatchInput:
    customers: List[CustomerInput]
    where customers.length <= maximum_batch_size() note "a batch contains at most 128 customers"

pub data ReportOptions:
    minimum_age: Int where minimum_age >= 0 = 13

pub data ImportReport:
    received: Int where received >= 0
    eligible: Int where eligible >= 0
    skipped_ineligible: Int where skipped_ineligible >= 0
    customers: List[Customer]
    where eligible + skipped_ineligible == received and customers.length == eligible

pub data ImportError:
    InputFormat(cause: JsonError)
    Rows(errors: DecodeErrors)
    ReportEncoding(cause: EncodeError)


func normalize(input: CustomerInput) -> Customer:
    return Customer(
        id=CustomerId(value=input.id.trim()),
        name=input.name.trim(),
        age=input.age,
    )

func decode_batch(text: Text) -> Result[BatchInput, ImportError]:
    raw: Value = json.parse(text)
        .map_error((error) => ImportError.InputFormat(error))?
    return BatchInput.decode(raw)
        .map_error((errors) => ImportError.Rows(errors))

pub func build_report(
    text: Text,
    options: ReportOptions,
) -> Result[ImportReport, ImportError]:
    batch = decode_batch(text)?
    eligible = filter(batch.customers, (row) => row.age >= options.minimum_age)
    customers = map(eligible, normalize)
    return Ok(ImportReport(
        received=batch.customers.length,
        eligible=customers.length,
        skipped_ineligible=batch.customers.length - customers.length,
        customers=customers,
    ))

# The UI can inspect a successful report before any export. Export uses an
# explicit encoder, not the human display of a data value. Filesystem/download
# failures belong to the host adapter; they are not fabricated ImportErrors.
pub func report_json(report: ImportReport) -> Result[Text, ImportError]:
    return json.encode(report)
        .map_error((error) => ImportError.ReportEncoding(error))


example "valid rows retain order and distinguish policy from malformed input":
    text = '{"customers":[{"id":" c-1 ","name":" Ada ","age":20},{"id":"c-2","name":"Bo","age":12}]}'
    result = build_report(text, ReportOptions())
    match result:
        Ok(report):
            check report.received == 2
            check report.eligible == 1
            check report.skipped_ineligible == 1
            check report.customers[0].id.value == "c-1"
            check report.customers[0].name == "Ada"
        Err(_):
            check false

example "malformed data cannot be hidden by eligibility filtering":
    text = '{"customers":[{"id":"c-1","name":"","age":-1}]}'
    rejected = match build_report(text, ReportOptions()):
        Ok(_) => false
        Err(_) => true
    check rejected
    # Required diagnostic: $.customers[0].name AND $.customers[0].age.
    # No successful report or report export; never silently drop the bad row.

# Additional independent vectors: empty input list; 128/129 rows; repeated IDs;
# unknown/missing fields; bool/fraction/text where Int is expected; duplicate
# JSON keys; huge integer; excessive bytes/depth; malformed UTF/text; stale run.
# Exact numbers/text, decoder/encoder shape, source/type/effect checking and
# host budgets are M1 admission work, not guarantees established by this file.
