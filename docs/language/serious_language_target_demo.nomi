# Target-only Nomi demo: serious language north star.
# Status: aspirational design fixture, not expected to parse today.
#
# Purpose:
#   This file sketches the kind of coherent syntax and semantics Nomi would
#   need to compete with Python, Julia, Mathematica, Haskell, R, and notebooks
#   without inheriting their historical seams.
#
# Discipline:
#   - Keep this file outside samples/. Runnable samples must only contain
#     implemented syntax covered by parser/runtime tests and snapshots.
#   - Every special-looking form below should reduce to one of Nomi's normal
#     forms: binding, function, pattern, flow, block, absence/result, data
#     boundary, or explanation.
#   - Comments marked NOTE(feature: ...) are design guidance for future
#     feature packets. They are not implementation promises.
#
# Scenario:
#   A small energy-analysis program imports sensor readings, decodes messy
#   external data, cleans a table, uses units and quantities, fits numerical
#   and symbolic models, explains failures, writes a report, and exposes a
#   small service endpoint. The domain is practical enough for Python/R/Julia
#   users and symbolic enough to pressure Mathematica-like capabilities.

module examples.energy_lab

from nomi.capability import requires
from nomi.cli import cli_args
from nomi.config import config, env, toml
from nomi.collections import count
from nomi.csv import read_csv
from nomi.explain import Trace, explain, trace
from nomi.files import Path, exists, open
from nomi.http import Request, Response, TransientNetworkError, bad_request, http, json
from nomi.math import fit, mean, pi, sin, solve, sum
from nomi.option import Option, Some, none
from nomi.result import Err, Error, Ok, Result, collect_results
from nomi.secrets import Secret
from nomi.symbolic import Assumption, Symbolic, assume, diff, quote, rewrite
from nomi.system import World
from nomi.table import Table, derive, group, rank, select, summarize, table, where
from nomi.text import matches
from nomi.time import Duration, Instant, floor_time, ms, now
from nomi.units import Quantity, degC, hr, kW, kWh, min


# ---------------------------------------------------------------------------
# 1. Configuration is ordinary data crossing an explicit boundary.
# ---------------------------------------------------------------------------

data EnergyConfig:
    readings:Path, exists(readings)
    output:Path
    horizon:Duration, horizon > 0 hr = 24 hr
    sample_period:Duration, sample_period > 0 min = 15 min
    min_quality:str = "ok"
    building_id:str, len(building_id) > 0

    # NOTE(feature: secrets-and-capabilities):
    # Credentials, tokens, and filesystem/network authority should be data
    # with redaction and capability provenance, not ambient globals.
    api_key:Secret[str]


func load_config(argv:list[str], world:World) -> Result[EnergyConfig, Error]:
    # NOTE(feature: data-boundary):
    # Config layering is a library flow that feeds a decode boundary. Nomi
    # should not need a separate config language.
    source =
        config.defaults
        |> config.merge(toml("energy-lab.toml"), optional=true)
        |> config.merge(env(world, prefix="ENERGY_"))
        |> config.merge(cli_args(argv))

    return EnergyConfig.decode(source).map_error(_.redact_secrets())


# ---------------------------------------------------------------------------
# 2. Domain values use one binding/constraint story.
# ---------------------------------------------------------------------------

data SensorId:
    value:str, matches(value, r"^[a-z][a-z0-9_-]+$")


data Reading:
    sensor:SensorId
    observed_at:Instant
    watts:Quantity["kW"], watts >= 0 kW
    outdoor_temp:Quantity["degC"]
    quality:str = "ok"


data ReadingRow:
    # External rows are intentionally looser than owned readings.
    sensor:any
    observed_at:any
    watts:any
    outdoor_temp:any
    quality:any = "ok"


func row_to_reading(row:ReadingRow) -> Result[Reading, Error]:
    # NOTE(feature: decode-plus-binding):
    # The same binding target machinery should validate decoder fields,
    # function parameters, pattern captures, and direct assignments.
    return Reading.decode({
        sensor: row.sensor,
        observed_at: row.observed_at,
        watts: Quantity.decode(row.watts, unit=kW),
        outdoor_temp: Quantity.decode(row.outdoor_temp, unit=degC),
        quality: row.quality,
    })


# ---------------------------------------------------------------------------
# 3. Tables and collections are one flow surface, not separate mini-languages.
# ---------------------------------------------------------------------------

func load_readings(config:EnergyConfig) -> Result[Table[Reading], Error]:
    trace "load readings":
        rows =
            read_csv(config.readings)
            |> select(ReadingRow.decode)
            |> collect_results

        match rows:
            case Err(error):
                return Err(error)
            case Ok(decoded_rows):
                pass

        readings =
            decoded_rows
            |> select(row_to_reading)
            |> collect_results

        match readings:
            case Err(error):
                return Err(error)
            case Ok(values):
                return Ok(table(values))


func clean_hourly(readings:Table[Reading], config:EnergyConfig) -> Table:
    # NOTE(feature: table-flow):
    # `derive`, `where`, `group`, and `summarize` should produce an
    # explainable plan when data is lazy, and ordinary values when eager.
    return readings
        |> where(_.quality >= config.min_quality)
        |> derive(
            hour = floor_time(_.observed_at, 1 hr),
            energy = _.watts * config.sample_period,
        )
        |> group(by=_.hour)
        |> summarize(
            kwh = sum(_.energy).to(kWh),
            avg_temp = mean(_.outdoor_temp).to(degC),
            samples = count(_),
        )
        |> where(_.samples > 0)


# ---------------------------------------------------------------------------
# 4. Numerical, generic, and symbolic code should compose.
# ---------------------------------------------------------------------------

data LinearTrend:
    slope:Quantity["kWh/hr"]
    intercept:Quantity["kWh"]


data DailySymbolicModel:
    expression:Symbolic
    assumptions:list[Assumption] = []


data ForecastPoint:
    hour:Instant
    expected:Quantity["kWh"], expected >= 0 kWh
    lower:Quantity["kWh"], lower >= 0 kWh
    upper:Quantity["kWh"], upper >= lower


data Forecast:
    model_name:str
    points:list[ForecastPoint]
    explanation:Trace


# NOTE(feature: multiple-dispatch):
# This is Julia pressure, but Nomi should explain dispatch instead of hiding it.
# These are ordinary functions with typed/constrained bindings and a shared
# dispatch table; no class hierarchy is required.
forecast(model:LinearTrend, hourly:Table) -> Forecast =
    fit_forecast(model, hourly)

forecast(model:DailySymbolicModel, hourly:Table) -> Forecast =
    symbolic_forecast(model, hourly)


func fit_linear(hourly:Table) -> LinearTrend:
    # NOTE(feature: numeric-arrays):
    # `rank(1, ...)` is the readable everyday spelling for axis/rank work.
    # Dense array glyphs may exist in scoped scientific profiles later, but
    # not as first-hour syntax.
    xs = hourly |> select(_.hour) |> rank(1, hours_since_start)
    ys = hourly |> select(_.kwh)
    coeffs = fit.linear(xs, ys)
    return LinearTrend(slope=coeffs.slope, intercept=coeffs.intercept)


func symbolic_daily_model() -> DailySymbolicModel:
    # NOTE(feature: symbolic):
    # `quote:` preserves source structure as data. Rewrites and derivatives
    # produce semantic events so notebooks and agents can inspect the path.
    expr = quote:
        demand(t) = baseline + daily_amp * sin(2 * pi * t / day)

    assumptions = [
        assume(baseline >= 0 kWh),
        assume(daily_amp >= 0 kWh),
        assume(day == 24 hr),
    ]

    simplified = rewrite(expr, rules=[trig_normalize, units_simplify])
    sensitivity = diff(simplified.demand(t), t)

    # NOTE(feature: symbolic-result):
    # Symbolic work should not just return an expression. It should carry
    # provenance, assumptions, and explanation events.
    explain(sensitivity)

    return DailySymbolicModel(expression=simplified, assumptions=assumptions)


func choose_model(hourly:Table) -> LinearTrend | DailySymbolicModel:
    match hourly |> count:
        case n if n < 48:
            return fit_linear(hourly)
        case _:
            return symbolic_daily_model()


# ---------------------------------------------------------------------------
# 5. Patterns distinguish shape failure from constraint failure.
# ---------------------------------------------------------------------------

func classify_event(event:any) -> Result[str, Error]:
    # NOTE(feature: constrained-patterns):
    # In a match case, shape non-match, guard failure, and constraint failure
    # must remain distinct in trace output.
    match event:
        case {"type": "reading", "watts": watts:(Quantity["kW"], watts >= 0 kW)}:
            return Ok("valid-reading")
        case {"type": "reading", "watts": watts}:
            return Err(Error("Reading has invalid watts", value=watts))
        case {"type": "heartbeat", "sensor": SensorId(id)}:
            return Ok("heartbeat:{id}")
        case _:
            return Ok("ignored")


# ---------------------------------------------------------------------------
# 6. Resources, retries, and transactions are block policies.
# ---------------------------------------------------------------------------

func write_report(config:EnergyConfig, forecast:Forecast) -> Result[Path, Error]
requires fs.write:
    # NOTE(feature: block-policy):
    # `using` is an ordinary call with a caller-side block. The callee owns
    # acquisition/cleanup policy; the block owns user code.
    using(open(config.output, mode="write")) -> file:
        file.write_json({
            building: config.building_id,
            model: forecast.model_name,
            points: forecast.points,
        })

    return Ok(config.output)


func publish_summary(config:EnergyConfig, forecast:Forecast) -> Result[None, Error]
requires network.http:
    # NOTE(feature: retry-policy):
    # Retry is a block policy, not a language keyword. It should emit enter,
    # retry, success/failure, and cancellation events.
    retry(3, on=TransientNetworkError, backoff=250 ms) -> attempt:
        http.post(
            "https://energy.example/buildings/{config.building_id}/forecast",
            json=forecast,
            auth=config.api_key,
        )

    return Ok(none)


# ---------------------------------------------------------------------------
# 7. HTTP handlers are another data boundary, not a framework-only story.
# ---------------------------------------------------------------------------

data ForecastRequest:
    horizon:Duration, horizon > 0 hr = 24 hr
    include_trace:bool = false


data ForecastResponse:
    building_id:str
    generated_at:Instant
    points:list[ForecastPoint]
    trace:Option[Trace] = none


func forecast_handler(request:Request, latest:Forecast) -> Response:
    match ForecastRequest.decode(request.json):
        case Err(error):
            return bad_request(explain(error))
        case Ok(input):
            return json(ForecastResponse(
                building_id=request.path["building_id"],
                generated_at=now(),
                points=latest.points.take(input.horizon / 1 hr),
                trace=Some(latest.explanation) if input.include_trace else none,
            ))


# ---------------------------------------------------------------------------
# 8. The entry point composes world boundaries, results, and explanation.
# ---------------------------------------------------------------------------

func main(argv:list[str], world:World) -> Result[None, Error]
requires fs.read, fs.write, network.http, clock.now:
    trace "energy forecast run":
        match load_config(argv, world):
            case Err(error):
                explain(error)
                return Err(error)
            case Ok(config):
                pass

        match load_readings(config):
            case Err(error):
                explain(error)
                return Err(error)
            case Ok(readings):
                pass

        hourly = clean_hourly(readings, config)
        model = choose_model(hourly)
        forecast = forecast(model, hourly)

        # NOTE(feature: explain):
        # `explain` is not a debugger bolted on later. It is a view over
        # semantic events from decode, table planning, dispatch, symbolic
        # rewrite, resource policies, and capability checks.
        explain(forecast)

        match write_report(config, forecast):
            case Err(error):
                explain(error)
                return Err(error)
            case Ok(path):
                print("Wrote forecast to {path}")

        match publish_summary(config, forecast):
            case Err(error):
                explain(error)
                return Err(error)
            case Ok(_):
                return Ok(none)


# ---------------------------------------------------------------------------
# Evolution checklist
# ---------------------------------------------------------------------------
#
# The demo above pressures these future feature packets:
#
# 1. Binding constraints everywhere:
#    assignments, params, data fields, pattern captures, decode fields.
#
# 2. Decode boundary:
#    accumulated field errors, source identity, redaction, Result values.
#
# 3. Table/flow:
#    one left-to-right surface for eager collections and lazy query plans.
#
# 4. Numeric arrays and rank:
#    readable rank/axis operators first; dense glyphs only in scoped profiles.
#
# 5. Multiple dispatch:
#    Julia-like generic functions with explainable dispatch and constraints.
#
# 6. Symbolic computation:
#    quote/rewrite/diff/solve with assumptions, provenance, and trace events.
#
# 7. Units and quantities:
#    typed quantities with conversion, dimensional checks, and diagnostics.
#
# 8. Pattern semantics:
#    clear difference between non-match, guard failure, and constraint failure.
#
# 9. Block policies:
#    using/retry/transaction as ordinary calls with caller-side blocks.
#
# 10. Capabilities:
#    explicit world contact for files, network, clock, secrets, subprocesses.
#
# 11. Explanation:
#    traces are structured data consumed by diagnostics, notebooks, tests,
#    playgrounds, agents, and `explain`.
#
# 12. Interop:
#    Python/Julia/R/JS/Rust bridges should be explicit backend boundaries, not
#    the definition of Nomi semantics.
