{
  "index_path": ".nomi/rag_index.json",
  "sources": [
    {
      "name": "nomi-codebase",
      "kind": "codebase",
      "path": ".",
      "include": [
        "AGENTS.md",
        "README.md",
        "docs/**/*.md",
        "prototype/**/*.py",
        "prototype/**/*.lark",
        "scripts/**/*.py",
        "tools/**/*.py"
      ],
      "exclude": [
        ".git/**",
        ".nomi/**",
        ".pytest_cache/**",
        "local/**",
        "PLAY/**",
        "reports/**",
        "**/__pycache__/**"
      ],
      "path_boosts": [
        {
          "pattern": "AGENTS.md",
          "boost": 1.35
        },
        {
          "pattern": "README.md",
          "boost": 1.2
        },
        {
          "pattern": "docs/design/**",
          "boost": 1.4
        },
        {
          "pattern": "docs/orientation/**",
          "boost": 1.1
        },
        {
          "pattern": "docs/research/**",
          "boost": 0.9
        },
        {
          "pattern": "docs/review/**",
          "boost": 0.75
        }
      ]
    },
    {
      "name": "programming-books",
      "kind": "books",
      "path": "Local_Programming_Books",
      "include": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst"
      ],
      "exclude": []
    }
  ]
}
