  "laws": [
    {
      "id": "alias-reference-v1",
      "status": "implemented closed rule",
      "statement": "An alias preserves the referenced object and its domain."
    },
    {
      "id": "mean-valid-exact-v1",
      "status": "implemented closed rule",
      "profile": "exact-rational-v1",
      "statement": "mean(x) = safe_divide(sum(x), count_valid(x)), with the same x and skip-null policy; zero denominator yields Missing."
