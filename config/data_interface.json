  "profiles": {
    "exact-rational-v1": {
      "arithmetic": "unbounded exact integer/rational",
      "missing": "skip declared nulls in aggregates",
      "sum_empty": "zero",
      "mean_empty": "Missing",
      "divide_zero": "Missing",
      "nan": "unsupported",
      "units": "dimensionless fragment"
    },
    "float64-opaque-v1": {
      "arithmetic": "backend numeric law unspecified; no mean expansion",
      "missing": "declared null distinct from NaN",
      "units": "dimensionless fragment"
    }
  },
